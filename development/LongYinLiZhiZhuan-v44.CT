 createID.Text='0';createID.Enabled=key~='horsearmor'
 local hints={horsearmor='马鞍无需填写 ID；选择右侧物品等级，再查询或添加。',weapon='武器 ID 0～35，例如 9＝长剑。',armor='护甲 ID 0～5。',helmet='头盔 ID 0～5。',shoes='鞋子 ID 0～5。',decoration='饰品种类：0香囊、1羽扇、2扳指、3玉佩、4腰带、5面具。',material='材料种类：0木材、1矿料、2药引、3食材、4毒物。',treasure='珍宝种类 0～9；档次决定具体名称，请查询确认。',book='填写功法 ID，或从秘籍目录选择；右侧选择版本。',[1]='丹药 ID 0～35；等级由物品配置决定。',[2]='饮食 ID 0～35；等级由物品配置决定。',[6]='马匹 ID 0～47；等级由物品配置决定。'}
 preview.Caption=hints[key]
