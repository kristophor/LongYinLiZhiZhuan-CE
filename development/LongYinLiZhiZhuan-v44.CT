[1049]="装备效果（基础配置）\n无\n\n升级效果（每级）\n射术潜力+1\n力道潜力+1\n体质潜力+1\n力道+2",
[1050]="装备效果（基础配置）\n无\n\n升级效果（每级）\n轻功潜力+1\n剑法潜力+1\n力道潜力+1\n经脉潜力+1",
}

local typeNames={[0]='装备','丹药','饮食','秘籍','珍宝','材料','马匹'}
local equipNames={[0]='武器','护甲','头盔','足履','饰品'}
local function qualityName(v,typ)
 if typ==3 then return ({[0]='残本','仿本','善本','古本','珍本','完本'})[v] or ('版本 '..tostring(v)) end
 return ({[1]='下品',[5]='极品'})[v] or ('品质 '..tostring(v))
end
local function plain(s) return (s or ''):gsub('&lt;br%s*/?&gt;','\n'):gsub('&lt;[^&gt;]*&gt;','') end
local function check(v,s) if not v then error(s,2) end return v end
local function q(a) local v=readQword(a);check(v and v~=0,'指针不可读，请读档完成后刷新');return v end
local function int(a) return check(readInteger(a),'整数不可读') end
local function flt(a) return check(readFloat(a),'浮点数不可读') end
local function cname(p) return readString(q(q(p)+0x10),120) end
local function str(p) if not p or p==0 then return '' end local n=int(p+0x10);check(n&gt;=0 and n&lt;=4096,'字符串长度异常');return readString(p+0x14,n*2,true) or '' end
local function context()
 local pid=getOpenedProcessID();check(pid and pid~=0,'请先在 CE 连接 LongYinLiZhiZhuan.exe')
 local base=check(getAddressSafe('GameAssembly.dll'),'未找到 GameAssembly.dll')
 local klass=q(base+0x1E52870)
 check(readString(q(klass+0x10),100)=='GameController','游戏版本/模块偏移不匹配')
 local instance=q(q(klass+0xB8));local world=q(instance+0x20)
 local heroes=q(world+0x50);local hero=q(q(heroes+0x10)+0x20)
 check(cname(hero)=='HeroData' and int(hero+0x58)==0,'未找到主角 heroID=0')
 local inv=q(hero+0x220);local list=q(inv+0x28);local count=int(list+0x18)
 check(count&gt;=0 and count&lt;=10000,'背包长度异常')
 return {pid=pid,world=world,hero=hero,inv=inv,list=list,array=q(list+0x10),count=count,version=int(list+0x1C)}
end
local function same(a,b)
 return a.pid==b.pid and a.world==b.world and a.hero==b.hero and a.inv==b.inv and a.list==b.list and a.array==b.array and a.count==b.count and a.version==b.version
end
local function item(p,index)
 check(cname(p)=='ItemData','背包物品类型异常')
 local r={ptr=p,index=index,klass=q(p),id=int(p+0x10),type=int(p+0x14),subtype=int(p+0x18),name=str(readQword(p+0x20)),quality=int(p+0x40),value=int(p+0x38),weight=flt(p+0x44)}
 r.level=int(p+0x3C);r.description=plain(str(readQword(p+0x30)));r.customName=str(readQword(p+0x58))
 r.displayName=r.customName~='' and r.customName or r.name
 r.typeName=typeNames[r.type] or ('品类 '..r.type)
 r.subtypeName=r.type==0 and (equipNames[r.subtype] or ('装备子类 '..r.subtype)) or ('子类 '..r.subtype)
 r.subtypeKey=tostring(r.type)..':'..tostring(r.subtype)
 r.qualityName=qualityName(r.quality,r.type);r.details={}
 local eq=readQword(p+0x60) or 0
 if eq~=0 then
  r.enhance=int(eq+0x10);r.equipped=readBytes(eq+0x30,1)==1
  r.details[#r.details+1]='强化等级：'..r.enhance..(r.equipped and '　已装备' or '')
 end
 r.med=readQword(p+0x68) or 0
 if r.med~=0 then
  check(cname(r.med)=='MedFoodData','药食对象类型异常')
  r.effect=q(r.med+0x18);check(cname(r.effect)=='ChangeHeroStateData','药效对象类型异常')
  r.hp=flt(r.effect+0x10);r.mana=flt(r.effect+0x18);r.power=flt(r.effect+0x20)
  for _,s in ipairs({{'生命',0x10},{'生命上限',0x14},{'内力',0x18},{'内力上限',0x1C},{'体力',0x20},{'体力上限',0x24},{'外伤',0x28},{'内伤',0x2C},{'毒伤',0x30}}) do
   local v=flt(r.effect+s[2]);if v~=0 then r.details[#r.details+1]=s[1]..string.format('%+g',v) end
  end
 end
 if r.type==6 then r.equipped=readBytes(q(p+0x88)+0x10,1)==1 end
 r.equipStatus=r.equipped and '● 已装备' or ((r.type==0 or r.type==6) and '未装备' or '—')
 local book=readQword(p+0x70) or 0
 if book~=0 then r.skillID=int(book+0x10);r.details[#r.details+1]='秘籍对应功法 ID：'..r.skillID;r.details[#r.details+1]=E.skillEffectText[r.skillID] or '效果配置未收录' end
 return r
end
function E.consumableGroups(typ)
 check(typ==1 or typ==2,'请选择丹药或饮食')
 local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏')
 local manager=q(q(q(base+0x1E528F8)+0xB8)+0x20)
 local dict=q(manager+(typ==1 and 0x120 or 0x128));local entries=q(dict+0x18);local count=int(dict+0x20)
 check(count&gt;=0 and count&lt;2000,'药食配置数量异常')
 local groups,map={},{}
 local effects={{'补血',0x10},{'生命上限',0x14},{'回内力',0x18},{'内力上限',0x1C},{'回体力',0x20},{'体力上限',0x24},{'外伤',0x28},{'内伤',0x2C},{'毒伤',0x30}}
 for n=0,count-1 do local e=entries+0x20+n*24;local hash=int(e)
  if hash&gt;=0 and hash&lt;0x80000000 then
   local r=item(q(e+16),n);check(r.type==typ and r.id==int(e+8),'药食配置不一致')
   local sig,names={},{}
   for _,v in ipairs(effects)do local x=flt(r.effect+v[2]);if x~=0 then
    sig[#sig+1]=v[2]..':'..(x&gt;0 and '+' or '-')
    names[#names+1]=(v[2]&gt;=0x28 and x&lt;0) and ('减'..v[1]) or v[1]
   end end
   local key=r.subtype..':'..table.concat(sig,',');local g=map[key]
   if not g then g={name=(typ==2 and (r.subtype==1 and '酒 · ' or r.subtype==0 and '食物 · ' or ('子类'..r.subtype..' · ')) or '')..(#names&gt;0 and table.concat(names,' / ') or '其他效果'),rows={}};map[key]=g;groups[#groups+1]=g end
   g.rows[#g.rows+1]=r
  end
 end
 for _,g in ipairs(groups)do
  table.sort(g.rows,function(a,b)return a.id&lt;b.id end)
  g.best=g.rows[1];g.minLevel=g.best.level;g.maxLevel=g.best.level
  local ranges={};local first,last
  for _,r in ipairs(g.rows)do
   if r.level&gt;g.best.level or (r.level==g.best.level and r.id&lt;g.best.id)then g.best=r end
   g.minLevel=math.min(g.minLevel,r.level);g.maxLevel=math.max(g.maxLevel,r.level)
   if not first then first,last=r.id,r.id elseif r.id==last+1 then last=r.id else ranges[#ranges+1]=first==last and tostring(first) or (first..'–'..last);first,last=r.id,r.id end
  end
  ranges[#ranges+1]=first==last and tostring(first) or (first..'–'..last)
  g.caption=g.name..' | ID '..table.concat(ranges,', ')..' | 等级 '..g.minLevel..'–'..g.maxLevel
 end
 table.sort(groups,function(a,b)return a.rows[1].id&lt;b.rows[1].id end)
 return groups
end

function E.describe(r)
 local lines={r.displayName or r.name,string.format('%s / %s　等级 %d　%s（%d）',r.typeName,r.subtypeName,r.level,r.qualityName,r.quality),string.format('物品 ID：%d　价值：%d　重量：%g',r.id,r.value,r.weight)}
 if r.customName~='' then lines[#lines+1]='基础名称：'..r.name end
 lines[#lines+1]='';lines[#lines+1]=r.description~='' and r.description or '无额外文字说明'
 for _,v in ipairs(r.details) do lines[#lines+1]=v end
 return table.concat(lines,'\r\n')
end
function E.filterSort(rows,opt)
 local out={};local term=(opt.search or ''):lower()
 for _,r in ipairs(rows) do
  local hay=table.concat({r.name,r.displayName or '',r.description or '',tostring(r.id),r.typeName or '',table.concat(r.details or {},' ')},' '):lower()
  if (term=='' or hay:find(term,1,true)) and (opt.type==nil or r.type==opt.type) and (opt.subtype==nil or r.subtypeKey==opt.subtype) and (opt.level==nil or r.level==opt.level) and (opt.quality==nil or r.quality==opt.quality) then out[#out+1]=r end
 end
 local key=opt.key or 'index';local asc=opt.asc~=false
 table.sort(out,function(a,b)
  local x,y=a[key],b[key]
  if x==y then return a.index&lt;b.index end
  if x==nil then return false end;if y==nil then return true end
  if type(x)~=type(y) then x,y=tostring(x),tostring(y) end
  if asc then return x&lt;y else return x&gt;y end
 end)
 return out
end
function E.snapshot()
 local c=context();local rows={}
 for n=0,c.count-1 do rows[#rows+1]=item(q(c.array+0x20+n*8),n) end
 check(same(c,context()),'扫描期间背包变化，请再刷新一次')
 return c,rows
end
local function identity(a,b)
 return a.ptr==b.ptr and a.klass==b.klass and a.id==b.id and a.type==b.type and a.subtype==b.subtype and a.name==b.name and a.med==b.med and a.effect==b.effect
end
function E.validate(c,old)
 local now=context();check(same(c,now),'已读档、切换进程或背包变化，请刷新并重新选择')
 check(q(now.array+0x20+old.index*8)==old.ptr,'物品位置变化，请刷新')
 local r=item(old.ptr,old.index);check(identity(old,r),'物品已变化，请刷新')
 return r
end
local specs={
 {key='quality',label='品质编码',off=0x40,integer=true,min=0,max=5},
 {key='value',label='价值',off=0x38,integer=true,min=0,max=100000000},
 {key='weight',label='重量',off=0x44,min=0,max=100000},
 {key='hp',label='生命恢复',off=0x10,effect=true,min=0,max=100000},
 {key='mana',label='内力恢复',off=0x18,effect=true,min=0,max=100000},
 {key='power',label='体力恢复',off=0x20,effect=true,min=0,max=100000}
}
E.specs=specs
local function equal(a,b) return a~=nil and b~=nil and math.abs(a-b)&lt;=math.max(0.0001,math.abs(b)*0.000001) end
function E.apply(c,old,input)
 check(not E.busy,'复制执行中，请等待完成')
 local r=E.validate(c,old);local changes={}
 for _,s in ipairs(specs) do
  if input[s.key]~=nil then
   check(not s.effect or r.effect,'当前物品没有药效字段')
   local v=tonumber(input[s.key]);check(v and v==v and v&gt;=s.min and v&lt;=s.max and (not s.integer or v==math.floor(v)),s.label..'数值无效，范围 '..s.min..'～'..s.max)
   check(equal(r[s.key],old[s.key]),s.label..'已经变化，请重新选择')
   if not equal(r[s.key],v) then changes[#changes+1]={spec=s,address=(s.effect and r.effect or r.ptr)+s.off,before=r[s.key],after=v} end
  end
 end
 if #changes==0 then return r,0 end
 -- A shared effect object would change more than the selected medicine.
 if r.effect then
  local _,rows=E.snapshot()
  for _,other in ipairs(rows) do if other.ptr~=r.ptr and other.effect==r.effect then
   for _,v in ipairs(changes) do check(not v.spec.effect,'该药效对象被其他物品共享，已拒绝修改') end
  end end
 end
 local written={}
 local ok,err=pcall(function()
  for _,v in ipairs(changes) do
   E.validate(c,old)
   local reader=v.spec.integer and readInteger or readFloat
   check(equal(reader(v.address),v.before),'字段已变化，停止写入')
   written[#written+1]=v
   check((v.spec.integer and writeInteger or writeFloat)(v.address,v.after),'写入失败')
   check(equal(reader(v.address),v.after),'写入后校验失败')
  end
 end)
 if not ok then
  local restored=pcall(function()
   E.validate(c,old)
   for i=#written,1,-1 do local v=written[i];local reader=v.spec.integer and readInteger or readFloat
    local current=reader(v.address);check(equal(current,v.after) or equal(current,v.before),'回退时字段已被其他操作改变')
    check((v.spec.integer and writeInteger or writeFloat)(v.address,v.before),'回退失败')
    check(equal(reader(v.address),v.before),'回退校验失败')
   end
  end)
  error(tostring(err)..(restored and '\n本次写入已回退。' or '\n无法确认完整回退，请重新读取测试存档。'))
 end
 local updated=item(old.ptr,old.index)
 E.lastUndo={ctx=c,after=updated,before=old,changes=changes}
 return updated,#changes
end
function E.undo()
 local u=check(E.lastUndo,'没有可撤销的操作');local values={}
 for _,v in ipairs(u.changes) do values[v.spec.key]=v.before end
 local r,n=E.apply(u.ctx,u.after,values);E.lastUndo=nil;return r,n
end
-- Included inside the inventory editor; only installs a bridge on an explicit copy request.
local function method(k,name,argc,rva,base)
 local tab=q(k+0x98)
 for n=0,2047 do
  local m=readQword(tab+n*8)
  if not m or m==0 or readQword(m+0x18)~=k then break end
  if readString(q(m+0x10),100)==name and readBytes(m+0x4A,1)==argc and q(m)==base+rva then
   return m
  end
 end
 error('未找到原生方法：'..name)
end
local function bytesEqual(a,expected)
 local actual=readBytes(a,#expected,true);if not actual then return false end
 for i,v in ipairs(expected) do if actual[i]~=v then return false end end;return true
end
local function assemble(code) local ok,err=autoAssemble(code);check(ok,'复制桥接编译失败：'..tostring(err)) end
-- Recover only the fully verified idle legacy bridge; never accept arbitrary hooks.
function E.recoverLegacyBridge(base,update,pid)
 if not bytesEqual(update,{0xE9}) or readBytes(update+5,1)~=0x90 then return end
 local displacement=readInteger(update+1);if not displacement then return end
 if displacement&gt;=0x80000000 then displacement=displacement-0x100000000 end
 local mem=update+5+displacement
 local raw=readBytes(mem,0x884,true);if not raw or #raw~=0x884 then return end
 if readQword(mem+0x45)~=mem+0x1000 then return end
 for j=70,77 do raw[j]=0 end
 if readQword(mem+0x1EA)~=base+0x1643A0 then return end
 for j=491,498 do raw[j]=0 end
 if readQword(mem+0x22A)~=base+0x1643A0 then return end
 for j=555,562 do raw[j]=0 end
 if readQword(mem+0x2CA)~=base+0x1643A0 then return end
 for j=715,722 do raw[j]=0 end
 if readQword(mem+0x314)~=base+0x1643A0 then return end
 for j=789,796 do raw[j]=0 end
 if readQword(mem+0x3B9)~=base+0x1643A0 then return end
 for j=954,961 do raw[j]=0 end
 if readQword(mem+0x3E6)~=base+0x1643A0 then return end
 for j=999,1006 do raw[j]=0 end
 if readQword(mem+0x4F1)~=base+0x1643A0 then return end
 for j=1266,1273 do raw[j]=0 end
 if readQword(mem+0x526)~=base+0x1643A0 then return end
 for j=1319,1326 do raw[j]=0 end
 if readQword(mem+0x562)~=base+0x1643A0 then return end
 for j=1379,1386 do raw[j]=0 end
 if readQword(mem+0x5C4)~=base+0x1643A0 then return end
 for j=1477,1484 do raw[j]=0 end
 if readQword(mem+0x611)~=base+0x1643A0 then return end
 for j=1554,1561 do raw[j]=0 end
 if readQword(mem+0x7FA)~=base+0x1643A0 then return end
 for j=2043,2050 do raw[j]=0 end
 local tail=readInteger(mem+0x880);if not tail then return end
 if tail&gt;=0x80000000 then tail=tail-0x100000000 end
 if mem+0x884+tail~=update+6 then return end
 for j=0x881,0x884 do raw[j]=0 end
 local expected=''
 for i=1,#raw do if raw[i]~=tonumber(expected:sub(i*2-1,i*2),16)then return end end
 local state=readInteger(mem+0x1000)
 check(state and state~=1 and state~=2,'旧桥接请求尚未完成，请等待后重试')
 return {pid=pid,base=base,mem=mem,data=mem+0x1000,update=update,patch=readBytes(update,6,true)}
end

function E.recoverCurrentBridge(base,update,pid)
 if not bytesEqual(update,{0xE9}) or readBytes(update+5,1)~=0x90 then return end
 local displacement=readInteger(update+1);if not displacement then return end
 if displacement&gt;=0x80000000 then displacement=displacement-0x100000000 end
 local mem=update+5+displacement
 local raw=readBytes(mem,0xA48,true);if not raw or #raw~=0xA48 then return end
 if readQword(mem+0x45)~=mem+0x1000 then return end
 for j=0x46,0x4D do raw[j]=0 end
 for _,off in ipairs({0x1e8,0x2a7,0x2f7,0x3ae,0x3ee,0x48e,0x4d8,0x57d,0x5aa,0x6b5,0x6ea,0x726,0x788,0x7d5,0x9be})do
  if readQword(mem+off)~=base+0x1643A0 then return end
  for j=off+1,off+8 do raw[j]=0 end
 end
 local tail=readInteger(mem+0xA44);if not tail then return end
 if tail&gt;=0x80000000 then tail=tail-0x100000000 end
 if mem+0xA48+tail~=update+6 then return end
 for j=0xA45,0xA48 do raw[j]=0 end
 local expected=''
 for j=1,#raw do if raw[j]~=tonumber(expected:sub(j*2-1,j*2),16)then return end end
 local state=readInteger(mem+0x1000)
 check(state and state&gt;=0 and state&lt;=7 and state~=1 and state~=2,'已有桥接请求尚未完成，请等待后重试')
 return {pid=pid,base=base,mem=mem,data=mem+0x1000,update=update,patch=readBytes(update,6,true),recoveredV13=true}
end

local function bridge(c,r)
 local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏')
 local saved=LongYiItemBridgeV13
 if saved and saved.pid==c.pid and saved.base==base then
  if bytesEqual(saved.update,saved.patch)then return saved end
  check(not LongYiCustomCallBusy and not LongYiWarehouseBusy and not LongYiBreakthroughCallBusy,'临时游戏调用正在执行，请稍后重试')
  local recovered=E.recoverCurrentBridge(base,base+0x18B9460,c.pid)
  check(recovered,'复制入口被其他脚本改变，停止')
  recovered.clone=saved.clone;recovered.add=saved.add;recovered.objectNew=saved.objectNew
  LongYiItemBridgeV13=recovered;return recovered
 end
 local clone=method(r.klass,'Clone',0,0xA1FCB0,base)
 local add=method(q(c.inv),'GetItem',2,0xA2DB90,base)
 local game=q(base+0x1E52870);method(game,'Update',0,0x18B9460,base)
 local update=base+0x18B9460;local original={0x40,0x53,0x48,0x83,0xEC,0x40}
 local previous=LongYiItemBridgeV12 or LongYiItemBridgeV11 or LongYiItemBridgeV10 or LongYiItemBridgeV9 or LongYiItemBridgeV8 or LongYiItemBridgeV7 or LongYiItemBridgeV6 or LongYiItemBridgeV5 or LongYiItemBridgeV4 or LongYiItemBridgeV3 or LongYiItemBridgeV2 or LongYiCloneBridge
 local predecessor=nil
 if not bytesEqual(update,original) then
  if not (previous and previous.pid==c.pid and previous.base==base and bytesEqual(update,previous.patch))then previous=E.recoverCurrentBridge(base,update,c.pid) or E.recoverLegacyBridge(base,update,c.pid)end
  check(previous and previous.pid==c.pid and previous.base==base and bytesEqual(update,previous.patch),'Update 入口已改变，停止安装')
  check(int(previous.data)~=1 and int(previous.data)~=2,'旧版复制请求未完成')
  predecessor=previous
 end
 check(bytesEqual(base+0xA1FCB0,{0x48,0x89,0x5C,0x24,0x08}),'Clone 代码版本不匹配')
 check(bytesEqual(base+0xA2DB90,{0x40,0x53,0x57,0x41,0x56}),'GetItem 代码版本不匹配')
 -- Resolve runtime_invoke by PE exports, not a guessed API address.
 local pe=int(base+0x3C);local er=int(base+pe+0x88);check(er&gt;0,'没有导出表')
 local e=base+er;local count=int(e+0x18);check(count&gt;0 and count&lt;100000,'导出表异常')
 local names=base+int(e+0x20);local ord=base+int(e+0x24);local funcs=base+int(e+0x1C);local invoke,objectNew
 for i=0,count-1 do
  local name=readString(base+int(names+i*4),120)
  if name=='il2cpp_runtime_invoke' then invoke=base+int(funcs+readSmallInteger(ord+i*2)*4) end
  if name=='il2cpp_object_new' then objectNew=base+int(funcs+readSmallInteger(ord+i*2)*4) end
 end
 check(invoke==base+0x1643A0,'runtime_invoke 版本不匹配')
 check(objectNew==base+0x164290,'object_new 版本不匹配')
 if predecessor and predecessor.recoveredV13 then
  predecessor.clone=clone;predecessor.add=add;predecessor.objectNew=objectNew
