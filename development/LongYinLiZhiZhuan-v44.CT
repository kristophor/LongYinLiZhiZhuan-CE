 local ok,err=autoAssemble(table.concat(lines,'\n'));need(ok,'无法还原指教开关：'..tostring(err))
 _G[key]=nil;return
end
need(not _G[key],'指点 / 传授解除已开启，请先取消原开关')
local pid=getOpenedProcessID();local base=need(getAddressSafe('GameAssembly.dll'),'请先连接游戏')
