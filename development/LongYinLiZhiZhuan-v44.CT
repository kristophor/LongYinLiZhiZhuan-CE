 local checks={}
 for _,off in ipairs({0x60,0x68,0x70,0x78,0x80,0x88}) do checks[#checks+1]=string.format('mov rax,[rdi+%X]\ntest rax,rax\njz @f\nmov rdx,[rsi+%X]\ntest rdx,rdx\njz invalid\ncmp rax,rdx\nje invalid\n@@:',off,off) end
 local continuation=predecessor and string.format('jmp %X',predecessor.mem) or string.format('db 40 53 48 83 EC 40\njmp %X',update+6)
 local replacements={MEM=string.format('%X',mem),DATA=string.format('%X',d),INVOKE=string.format('%X',invoke),CONTINUE=continuation,CHILD_CHECKS=table.concat(checks,'\n')}
 local code=template:gsub('%%([A-Z_]+)%%',replacements)
 assemble(code)
 local expected={};for _,v in ipairs(predecessor and predecessor.patch or original) do expected[#expected+1]=string.format('%02X',v) end
 assemble(string.format('assert(%X,%s)\n%X:\njmp %X\nnop',update,table.concat(expected,' '),update,mem))
 local b={pid=c.pid,base=base,mem=mem,data=d,update=update,patch=readBytes(update,6,true),clone=clone,add=add,objectNew=objectNew}
 LongYiItemBridgeV13=b;return b
end
function E.deleteOne(c,old,onDone)
 check(not E.busy and not E.skillTraining,'已有请求执行中，请等待')
 local r=E.validate(c,old)
 local function unequipped()
  if r.type==0 then check(readBytes(q(r.ptr+0x60)+0x30,1)==0,'请先在游戏中卸下该装备')end
  if r.type==6 then check(readBytes(q(r.ptr+0x88)+0x10,1)==0,'请先在游戏中卸下该坐骑')end
 end
 unequipped()
 local before,rows=E.snapshot();check(same(c,before),'背包已变化，请刷新')
 local base=getAddressSafe('GameAssembly.dll');local target=method(q(c.inv),'LoseItem',2,0xA2E020,base)
 local b=bridge(c,r);local d=b.data;check(int(d)~=1 and int(d)~=2,'桥接请求尚未结束')
 for off,v in pairs({[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x40]=r.ptr,[0x48]=0x20+r.index*8,[0x50]=target,[0x68]=0,[0x200]=r.ptr,[0x208]=d+0x248})do check(writeQword(d+off,v),'删除参数写入失败')end
 for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=9,[0x248]=0})do check(writeInteger(d+off,v),'删除参数写入失败')end
 E.validate(c,old);unequipped()
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100;E.busy=true;E.copyTimer=timer
 local finished=false
 local function finish(ok,msg)if finished then return end;finished=true;timer.destroy();E.copyTimer=nil;E.busy=false;onDone(ok,msg)end
 timer.OnTimer=function()
  if getOpenedProcessID()~=c.pid then finish(false,'进程已切换，请核对删除结果');return end
  local state=readInteger(d);if state==1 or state==2 then return end
  local ok,msg=pcall(function()
   check(state==3,'删除未完成，状态 '..tostring(state)..'；请刷新核对，不要重复提交')
   local now,after=E.snapshot();check(now.world==c.world and now.hero==c.hero and now.inv==c.inv,'已切换存档，请核对结果')
   check(now.count==c.count-1,'删除后物品数量不符，请核对')
   local pointers={};for _,v in ipairs(after)do check(v.ptr~=r.ptr,'目标仍在背包中');check(not pointers[v.ptr],'背包对象重复');pointers[v.ptr]=true end
   for _,v in ipairs(rows)do if v.ptr~=r.ptr then check(pointers[v.ptr],'其他物品发生变化，请核对')end end
   local types=q(now.inv+0x30);local category=q(q(types+0x10)+0x20+r.type*8);local array=q(category+0x10)
   for n=0,int(category+0x18)-1 do check(readQword(array+0x20+n*8)~=r.ptr,'分类列表仍有目标物品')end
   return '已删除 1 件「'..r.name..'」；背包及分类列表已核对。'
  end)
  finish(ok,tostring(msg))
 end
 if not writeInteger(d,1)then finish(false,'删除请求提交失败');return end
 timer.Enabled=true
end

function E.copyOne(c,old,onDone,creation)
 check(not E.busy,'已有复制请求，请等待完成')
 local function validate()
  if not creation then return E.validate(c,old) end
  check(same(c,context()),'背包或存档已变化，请刷新')
  local fresh=E.creationLookup(creation.key or creation.type,creation.id,creation.option or creation.level)
  check(identity(old,fresh.template),'配置物品已变化，请重新查询')
  return fresh.template
 end
 local r=validate()
 local b=bridge(c,r);check(int(b.data)~=1 and int(b.data)~=2,'已有请求等待游戏执行，不要重复点击')
 local now=validate();check(identity(r,now),'物品变化，请刷新')
 local instance=q(q(q(getAddressSafe('GameAssembly.dll')+0x1E52870)+0xB8))
 local d=b.data
 local values={[0x08]=instance,[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x40]=r.ptr,[0x48]=0x20+r.index*8,[0x50]=b.clone,[0x58]=b.add,[0x60]=0,[0x68]=0}
 for off,v in pairs(values) do check(writeQword(d+off,v),'复制参数写入失败') end
 check(writeInteger(d+0x98,creation and (creation.key=='book' and 2 or 1) or 0),'模式写入失败')
 check(writeInteger(d+0xE0,creation and creation.dynamic and 1 or 0),'校验模式写入失败')
 if creation then
  local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏')
  local generator=method(creation.key=='book' and r.klass or q(base+0x1E52870),creation.method,creation.argc,creation.rva,base)
  check(writeQword(d+0x50,generator),'生成方法写入失败')
  check(writeInteger(d+0xD0,creation.type) and writeInteger(d+0xD4,creation.dynamic and 0 or creation.id),'目标校验参数写入失败')
  if creation.dynamic then
   check(writeInteger(d+0xD8,creation.subtype) and writeInteger(d+0xDC,creation.id) and writeInteger(d+0xE4,creation.level),'分类校验写入失败')
   check(writeInteger(d+0x240,creation.id) and writeInteger(d+0x248,creation.option) and writeFloat(d+0x250,0),'生成参数写入失败')
   check(writeQword(d+0x210,d+0x250),'参数表写入失败')
   if creation.key=='decoration' then
    check(writeInteger(d+0x240,creation.level) and writeInteger(d+0x248,creation.id) and writeQword(d+0x218,c.hero),'饰品参数写入失败')
   end
   if creation.key=='horsearmor' then
    check(writeInteger(d+0x240,creation.level) and writeFloat(d+0x248,0),'马鞍参数写入失败')
   end
   if creation.key=='book' then
    local ctor=method(r.klass,'.ctor',1,0xA247C0,base)
    check(b.objectNew==base+0x164290,'object_new 导出版本不匹配')
    check(writeQword(d+0xF0,base+0x164290) and writeQword(d+0xF8,ctor) and writeQword(d+0x220,d+0xD0),'构造参数写入失败')
   end
  elseif creation.argc==4 then
   check(writeInteger(d+0x240,creation.level) and writeInteger(d+0x248,creation.id) and writeFloat(d+0x250,0),'装备参数写入失败')
   check(writeQword(d+0x210,d+0x250) and writeQword(d+0x218,c.hero),'装备参数表写入失败')
  else
   check(writeInteger(d+0x240,creation.id) and writeFloat(d+0x248,0),'生成参数写入失败')
  end
  check(writeQword(d+0x200,d+0x240) and writeQword(d+0x208,d+0x248) and writeQword(d+0xC8,d+0x200),'生成参数表写入失败')
 end
 check(writeInteger(d+0x38,c.version) and writeInteger(d+0x3C,c.count),'复制参数写入失败')
 validate();E.busy=true;E.lastUndo=nil
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100;E.copyTimer=timer
 timer.OnTimer=function()
  if getOpenedProcessID()~=b.pid then timer.destroy();E.copyTimer=nil;E.busy=false;onDone(false,'游戏进程已切换，请重新刷新。');return end
  local state=readInteger(d)
  if state==1 or state==2 then return end
  timer.destroy();E.copyTimer=nil;E.busy=false
  local ok,result=pcall(function()
   check(state==3,({[4]='等待执行时背包或存档变化，未添加物品。',[5]='游戏方法报告异常，结果可能不完整，请检查背包，勿自动重试。',[6]='复制未产生独立对象，已阻止添加。'})[state] or '复制状态异常，请检查背包')
   local ptr=q(d+0x60);local current,rows=E.snapshot()
   check(current.world==c.world and current.inv==c.inv,'复制后已切换存档，请手动检查')
   local found,source
   for _,v in ipairs(rows) do if v.ptr==ptr then check(not found,'新对象在背包中重复出现');found=v end;if v.ptr==r.ptr then source=v end end
   if creation then source=r end
   check(found and source and found.ptr~=source.ptr,'无法核对新增物品，勿重复点击')
   if creation and creation.dynamic then
    check(found.type==creation.type and found.subtype==creation.subtype and found.level==creation.level and (creation.key=='decoration' or creation.key=='horsearmor' or found.name==creation.name),'新增物品身份不一致')
    if creation.key=='decoration' then check(int(q(found.ptr+0x60)+0x14)==creation.id,'新增饰品种类不一致') end
    if creation.key=='book' then check(found.skillID==creation.id and found.quality==creation.option,'秘籍功法或版本不一致') end
   else
    check((creation and creation.argc==4 or found.name==r.name) and found.id==r.id and found.type==r.type and found.subtype==r.subtype,'新增物品身份不一致')
   end
   if creation and creation.argc==4 then check(found.level==creation.level,'新增装备等级不一致') end
   if not creation then check(found.quality==r.quality and found.value==r.value,'副本数值不一致') end
   check(not found.effect or (found.effect~=source.effect and (creation or (equal(found.hp,r.hp) and equal(found.mana,r.mana) and equal(found.power,r.power)))),'新物品药效验证失败')
   local types=q(current.inv+0x30);check(found.type&gt;=0 and found.type&lt;int(types+0x18),'分类索引异常')
   local category=q(q(types+0x10)+0x20+found.type*8);local ca=q(category+0x10);local matched=0
   for i=0,int(category+0x18)-1 do if readQword(ca+0x20+i*8)==ptr then matched=matched+1 end end
   check(matched==1,'分类列表验证失败')
   return (creation and '已添加' or '已复制')..' 1 件「'..found.name..'」，品质 '..found.quality..'；独立对象和分类列表已核对。'
  end)
  onDone(ok,tostring(result))
 end
 local queued=writeInteger(d,1)
 if not queued then timer.destroy();E.copyTimer=nil;E.busy=false;error('未能提交复制请求') end
 timer.Enabled=true
end
local creators={
 weapon={type=0,subtype=0,argc=4,offset=0xF0,method='GenerateWeapon',rva=0x188C220},
 armor={type=0,subtype=1,argc=4,offset=0x100,method='GenerateArmor',rva=0x187B540},
 helmet={type=0,subtype=2,argc=4,offset=0x108,method='GenerateHelmet',rva=0x187FD40},
 shoes={type=0,subtype=3,argc=4,offset=0x110,method='GenerateShoes',rva=0x188A2E0},
 [1]={offset=0x120,method='GenerateMedData',rva=0x18847F0},
 [2]={offset=0x128,method='GenerateFoodData',rva=0x187E160},
 [6]={offset=0x130,method='GenerateHorseData',rva=0x1883D70}
}
function E.creationLookup(key,id,level)
 if key=='material' or key=='treasure' or key=='book' or key=='decoration' or key=='horsearmor' then
  check(type(id)=='number' and id==math.floor(id) and id&gt;=0 and id&lt;=1000000,'请输入有效种类编号或功法 ID')
  check(type(level)=='number' and level==math.floor(level) and level&gt;=0 and level&lt;=5,'等级或秘籍版本必须为 0～5')
  local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏')
  local global=q(base+0x1E538E8);check(readString(q(global+16),120)=='GlobalData','全局配置版本不匹配');local st=q(global+0xB8)
  local c,rows=E.snapshot();check(#rows&gt;0,'请先让背包至少拥有一件物品以定位物品类型')
  local out={key=key,id=id,option=level,level=level,dynamic=true,template=rows[1],argc=3,subtype=id}
  if key=='horsearmor' then
   local levels=q(st+0x510);out.name=str(q(q(levels+0x10)+0x20+level*8))..'马鞍'
   out.type=6;out.subtype=1;out.argc=2;out.method='GenerateHorseArmorData';out.rva=0x18837C0
   out.description='按所选等级生成马鞍；品质由游戏生成，不需要填写 ID。'
  elseif key=='decoration' then
   local names=q(st+0x4E8);check(id&lt;int(names+0x18),'饰品种类不存在（0～5）')
   local levels=q(st+0x510);out.name=str(q(q(levels+0x10)+0x20+level*8))..str(q(q(names+0x10)+0x20+id*8))
   out.type=0;out.subtype=4;out.argc=4;out.method='GenerateDecoration';out.rva=0x187D540
   out.description='按饰品种类和等级生成独立装备，品质、属性及特殊名称由游戏生成。'
  elseif key=='material' then
   local names=q(st+0x558);check(id&lt;int(names+0x18),'材料种类不存在（0～4）')
   check(not (int(st)==2 and id==4),'当前游戏模式会将毒物转换为药引，已停止添加')
   local levels=q(st+0x510);out.name=str(q(q(levels+0x10)+0x20+level*8))..str(q(q(names+0x10)+0x20+id*8))
   out.type=5;out.method='GenerateMaterial';out.rva=0x18843D0
  elseif key=='treasure' then
   local names=q(st+0x538);local bounds=q(names+0x10);local kinds=int(bounds);local levels=int(bounds+16)
   check(kinds&gt;0 and kinds&lt;=100 and levels==6 and id&lt;kinds,'珍宝种类不存在（0～9）')
   out.name=str(q(names+0x20+(id*levels+level)*8));out.type=4;out.method='GenerateTreasure';out.rva=0x188C170
  else
   local manager=q(q(q(base+0x1E528F8)+0xB8)+0x20);local dict=q(manager+0x138);local entries=q(dict+0x18);local count=int(dict+0x20)
   check(count&gt;=0 and count&lt;100000,'功法字典异常');local skill
   for n=0,count-1 do local e=entries+0x20+n*24;if int(e)&gt;=0 and int(e+8)==id then skill=q(e+16);break end end
   if not skill then
    local custom=readQword(c.world+0x268)
    if custom and custom~=0 then
     local total=int(custom+0x20);check(total&gt;=0 and total&lt;100000,'自创功法字典异常')
     local data=total&gt;0 and q(custom+0x18) or 0
     for n=0,total-1 do
      local entry=data+0x20+n*24;local hash=int(entry)
      if hash&gt;=0 and hash&lt;0x80000000 and int(entry+8)==id then
       local wrapper=q(entry+16);skill=q(wrapper+16)
       check(cname(skill)=='KungfuSkillData','自创功法配置类型不匹配')
       out.custom=true;break
      end
     end
    end
   end
   check(skill and int(skill+0x14)==id,'功法 ID 不存在，未添加秘籍')
   out.name=str(q(skill+0x20));out.description=str(readQword(skill+0x28));out.level=int(skill+0x34)
   out.type=3;out.subtype=0;out.argc=2;out.method='SetBookData';out.rva=0xA23B60
  end
  out.description=out.description or '由游戏原生生成属性；种类编号与物品 ID 是不同字段。'
  return out
 end
 local spec=check(creators[key],'目前支持武器、护甲、头盔、鞋子、丹药、饮食、马匹')
 local typ=spec.type or key
 if spec.argc==4 then check(type(level)=='number' and level==math.floor(level) and level&gt;=0 and level&lt;=5,'装备等级必须为 0～5') end
 check(type(id)=='number' and id==math.floor(id) and id&gt;=0 and id&lt;=1000000,'请输入有效的非负整数 ID')
 local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏');local k=q(base+0x1E528F8)
 check(readString(q(k+16),120)=='GameDataController','配置管理器版本不匹配')
 local manager=q(q(k+0xB8)+0x20);local dict=q(manager+spec.offset)
 check(cname(dict)=='Dictionary`2','配置字典类型不匹配')
 local count=int(dict+0x20);check(count&gt;=0 and count&lt;100000,'配置字典长度异常')
 local entries=q(dict+0x18)
 for n=0,count-1 do
  local e=entries+0x20+n*24
  if readInteger(e)&gt;=0 and int(e+8)==id then
   local r=item(q(e+16),-1);check(r.type==typ and r.id==id and (spec.subtype==nil or r.subtype==spec.subtype),'配置 ID/品类不一致')
   return {key=key,type=typ,id=id,level=spec.argc==4 and level or nil,argc=spec.argc or 2,method=spec.method,rva=spec.rva,template=r}
  end
 end
 error('该品类不存在 ID '..id..'，未添加任何物品')
end
function E.addByID(typ,id,onDone,level)
 local creation=E.creationLookup(typ,id,level);local c=E.snapshot()
 E.copyOne(c,creation.template,onDone,creation)
end

local catalogJson=(function()
--
-- json.lua
--
-- Copyright (c) 2020 rxi
--
-- Permission is hereby granted, free of charge, to any person obtaining a copy of
-- this software and associated documentation files (the "Software"), to deal in
-- the Software without restriction, including without limitation the rights to
-- use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies
-- of the Software, and to permit persons to whom the Software is furnished to do
-- so, subject to the following conditions:
--
-- The above copyright notice and this permission notice shall be included in all
-- copies or substantial portions of the Software.
--
-- THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
-- IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
-- FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
-- AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
-- LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
-- OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
-- SOFTWARE.
--

local json = { _version = "0.1.3" } 

-------------------------------------------------------------------------------
-- Encode
-------------------------------------------------------------------------------

local encode

local escape_char_map = {
  [ "\\" ] = "\\",
  [ "\"" ] = "\"",
  [ "\b" ] = "b",
  [ "\f" ] = "f",
  [ "\n" ] = "n",
  [ "\r" ] = "r",
  [ "\t" ] = "t",
}

local escape_char_map_inv = { [ "/" ] = "/" }
for k, v in pairs(escape_char_map) do
  escape_char_map_inv[v] = k
end


local function escape_char(c)
  return "\\" .. (escape_char_map[c] or string.format("u%04x", c:byte()))
end


local function encode_nil(val)
  return "null"
end


function encode_table(val, stack)
  local res = {}
  stack = stack or {}

  -- Circular reference?
  if stack[val] then error("circular reference") end

  stack[val] = true

  local val1=rawget(val,1)
  local valnextr1,valnextr22=next(val)

  local isArray
  local md=getmetatable(val)
  if md and md.isArray then
    isArray=true
  else
    isArray=val1~=nil or tonumber(valnextr1)
  end

  if isArray then
    -- Treat as array -- check keys are valid and it is not sparse
    local n = 0
    for k in pairs(val) do
      if type(k) ~= "number" then
        error("invalid table: mixed or invalid key types")
      end
      n = n + 1
    end
    if n ~= #val then
      error("invalid table: sparse array")
    end
    -- Encode
    for i, v in ipairs(val) do
      table.insert(res, encode(v, stack))
    end
    stack[val] = nil
    return "[" .. table.concat(res, ",") .. "]"

  else
    -- Treat as an object
    for k, v in pairs(val) do
      if type(k) ~= "string" then
        error("invalid table: mixed or invalid key types")
      end
      table.insert(res, encode(k, stack) .. ":" .. encode(v, stack))
    end
    stack[val] = nil
    return "{" .. table.concat(res, ",") .. "}"
  end
end


local function encode_string(val)
  return '"' .. val:gsub('[%z\1-\31\\"]', escape_char) .. '"'
end


local function encode_number(val)
  -- Check for NaN, -inf and inf
  if val ~= val or val &lt;= -math.huge or val &gt;= math.huge then
    error("unexpected number value '" .. tostring(val) .. "'")
  end
  
  if val&gt;0xffffffff then --there's loss of accuracy for 'number' types in thge json specs so output those as hex strings
    return string.format([["0x%x"]],val) --output as a string
  end
  
  return string.format("%.14g", val)
end


local type_func_map = {
  [ "nil"     ] = encode_nil,
  [ "table"   ] = encode_table,
  [ "string"  ] = encode_string,
  [ "number"  ] = encode_number,
  [ "boolean" ] = tostring,
}


encode = function(val, stack)
  local t = type(val)
  local f = type_func_map[t]
  if f then
    return f(val, stack)
  end
  error("unexpected type '" .. t .. "'")
end


function json.encode(val)
  return ( encode(val) )
end


-------------------------------------------------------------------------------
-- Decode
-------------------------------------------------------------------------------

local parse

local function create_set(...)
  local res = {}
  for i = 1, select("#", ...) do
    res[ select(i, ...) ] = true
  end
  return res
end

local space_chars   = create_set(" ", "\t", "\r", "\n")
local delim_chars   = create_set(" ", "\t", "\r", "\n", "]", "}", ",")
local escape_chars  = create_set("\\", "/", '"', "b", "f", "n", "r", "t", "u")
local literals      = create_set("true", "false", "null")

local literal_map = {
  [ "true"  ] = true,
  [ "false" ] = false,
  [ "null"  ] = nil,
}


local function next_char(str, idx, set, negate)
  for i = idx, #str do
    if set[str:sub(i, i)] ~= negate then
      return i
    end
  end
  return #str + 1
end


local function decode_error(str, idx, msg)
  local line_count = 1
  local col_count = 1
  for i = 1, idx - 1 do
    col_count = col_count + 1
    if str:sub(i, i) == "\n" then
      line_count = line_count + 1
      col_count = 1
    end
  end
  error( string.format("%s at line %d col %d", msg, line_count, col_count) )
end


local function codepoint_to_utf8(n)
  -- http://scripts.sil.org/cms/scripts/page.php?site_id=nrsi&amp;id=iws-appendixa
  local f = math.floor
  if n &lt;= 0x7f then
    return string.char(n)
  elseif n &lt;= 0x7ff then
    return string.char(f(n / 64) + 192, n % 64 + 128)
  elseif n &lt;= 0xffff then
    return string.char(f(n / 4096) + 224, f(n % 4096 / 64) + 128, n % 64 + 128)
  elseif n &lt;= 0x10ffff then
    return string.char(f(n / 262144) + 240, f(n % 262144 / 4096) + 128,
                       f(n % 4096 / 64) + 128, n % 64 + 128)
  end
  error( string.format("invalid unicode codepoint '%x'", n) )
end


local function parse_unicode_escape(s)
  local n1 = tonumber( s:sub(1, 4),  16 )
  local n2 = tonumber( s:sub(7, 10), 16 )
   -- Surrogate pair?
  if n2 then
    return codepoint_to_utf8((n1 - 0xd800) * 0x400 + (n2 - 0xdc00) + 0x10000)
  else
    return codepoint_to_utf8(n1)
  end
end


local function parse_string(str, i)
  local res = ""
  local j = i + 1
  local k = j

  while j &lt;= #str do
    local x = str:byte(j)

    if x &lt; 32 then
      decode_error(str, j, "control character in string")

    elseif x == 92 then -- `\`: Escape
      res = res .. str:sub(k, j - 1)
      j = j + 1
      local c = str:sub(j, j)
      if c == "u" then
        local hex = str:match("^[dD][89aAbB]%x%x\\u%x%x%x%x", j + 1)
                 or str:match("^%x%x%x%x", j + 1)
                 or decode_error(str, j - 1, "invalid unicode escape in string")
        res = res .. parse_unicode_escape(hex)
        j = j + #hex
      else
        if not escape_chars[c] then
          decode_error(str, j - 1, "invalid escape char '" .. c .. "' in string")
        end
        res = res .. escape_char_map_inv[c]
      end
      k = j + 1

    elseif x == 34 then -- `"`: End of string
      res = res .. str:sub(k, j - 1)
      return res, j + 1
    end

    j = j + 1
  end

  decode_error(str, i, "expected closing quote for string")
end


local function parse_number(str, i)
  local x = next_char(str, i, delim_chars)
  local s = str:sub(i, x - 1)
  local n = tonumber(s)
  if not n then
    decode_error(str, i, "invalid number '" .. s .. "'")
  end
  return n, x
end


local function parse_literal(str, i)
  local x = next_char(str, i, delim_chars)
  local word = str:sub(i, x - 1)
  if not literals[word] then
    decode_error(str, i, "invalid literal '" .. word .. "'")
  end
  return literal_map[word], x
end


local function parse_array(str, i)
  local res = {}
  local n = 1
  i = i + 1
  while 1 do
    local x
    i = next_char(str, i, space_chars, true)
    -- Empty / end of array?
    if str:sub(i, i) == "]" then
      i = i + 1
      break
    end
    -- Read token
    x, i = parse(str, i)
    res[n] = x
    n = n + 1
    -- Next token
    i = next_char(str, i, space_chars, true)
    local chr = str:sub(i, i)
    i = i + 1
    if chr == "]" then break end
    if chr ~= "," then decode_error(str, i, "expected ']' or ','") end
  end
  return res, i
end


local function parse_object(str, i)
  local res = {}
  i = i + 1
  while 1 do
    local key, val
    i = next_char(str, i, space_chars, true)
    -- Empty / end of object?
    if str:sub(i, i) == "}" then
      i = i + 1
      break
    end
    -- Read key
    if str:sub(i, i) ~= '"' then
      decode_error(str, i, "expected string for key")
    end
    key, i = parse(str, i)
    -- Read ':' delimiter
    i = next_char(str, i, space_chars, true)
    if str:sub(i, i) ~= ":" then
      decode_error(str, i, "expected ':' after key")
    end
    i = next_char(str, i + 1, space_chars, true)
    -- Read value
    val, i = parse(str, i)
    -- Set
    res[key] = val
    -- Next token
    i = next_char(str, i, space_chars, true)
    local chr = str:sub(i, i)
    i = i + 1
    if chr == "}" then break end
    if chr ~= "," then decode_error(str, i, "expected '}' or ','") end
  end
  return res, i
end


local char_func_map = {
  [ '"' ] = parse_string,
  [ "0" ] = parse_number,
  [ "1" ] = parse_number,
  [ "2" ] = parse_number,
  [ "3" ] = parse_number,
  [ "4" ] = parse_number,
  [ "5" ] = parse_number,
  [ "6" ] = parse_number,
  [ "7" ] = parse_number,
  [ "8" ] = parse_number,
  [ "9" ] = parse_number,
  [ "-" ] = parse_number,
  [ "t" ] = parse_literal,
  [ "f" ] = parse_literal,
  [ "n" ] = parse_literal,
  [ "[" ] = parse_array,
  [ "{" ] = parse_object,
}


parse = function(str, idx)
  local chr = str:sub(idx, idx)
  local f = char_func_map[chr]
  if f then
    return f(str, idx)
  end
  decode_error(str, idx, "unexpected character '" .. chr .. "'")
end


function json.decode(str)
  if type(str) ~= "string" then
    error("expected argument of type string, got " .. type(str))
  end
  local res, idx = parse(str, next_char(str, 1, space_chars, true))
  idx = next_char(str, idx, space_chars, true)
  if idx &lt;= #str then
    decode_error(str, idx, "trailing garbage")
  end
  return res
end


return json
end)()
function E.loadBookCatalog(path)
 local f=check(io.open(path,'rb'),'无法打开 JSON 文件')
 local text=f:read(10*1024*1024+1);f:close();check(#text&lt;=10*1024*1024,'目录文件超过 10MB')
 if E.bookCatalog and E.bookCatalogSource==text then E.bookCatalogPath=path;return E.bookCatalog end
 local data=catalogJson.decode(text:gsub('^\239\187\191',''))
 check(type(data)=='table' and data.schema=='longyi.book-catalog' and data.schema_version==1,'不是支持的龙胤秘籍目录')
 check(type(data.books)=='table' and #data.books&lt;=20000 and #data.books==data.count,'目录数量不符')
 local seen={};local byID={}
 for _,b in ipairs(data.books) do
  check(type(b)=='table' and type(b.skill_id)=='number' and b.skill_id&gt;=0 and b.skill_id&lt;=1000000 and b.skill_id%1==0 and not seen[b.skill_id],'功法 ID 无效或重复');seen[b.skill_id]=true
  for _,k in ipairs({'name','description','type_name','level_name','faction_name'}) do check(type(b[k])=='string' and #b[k]&lt;=100000,'目录文字字段无效：'..k) end
  check(type(b.level)=='number' and b.level%1==0 and type(b.type_id)=='number' and type(b.faction_id)=='number','目录分类字段无效')
  if b.range_data~=nil then
   local ranges=b.range_data;check(type(ranges)=='table' and type(ranges.attack)=='table' and #ranges.attack&lt;=20,'范围配置格式异常')
   local function validate(r,maxType)
    check(type(r)=='table','范围条目无效')
    for _,key in ipairs({'type','min','max'})do local v=r[key];check(type(v)=='number' and v==math.floor(v) and v&gt;=0 and v&lt;=(key=='type' and maxType or 50),'范围数值无效：'..key)end
   end
   for _,r in ipairs(ranges.attack)do validate(r,4)end;validate(ranges.damage,8)
  end
  b._search=table.concat({b.name,tostring(b.skill_id),b.description,b.type_name,b.level_name,b.faction_name},' '):lower();byID[b.skill_id]=b
 end
 E.bookCatalog=data;E.bookCatalogByID=byID;E.bookCatalogSource=text;E.bookCatalogPath=path;return data
end
function E.filterBooks(books,opt)
 local out={};local term=(opt.search or ''):lower()
 for _,b in ipairs(books) do
  local text=b._search or table.concat({b.name,tostring(b.skill_id),b.description,b.type_name,b.level_name,b.faction_name},' '):lower()
  if (term=='' or text:find(term,1,true)) and (opt.type_id==nil or b.type_id==opt.type_id) and (opt.level==nil or b.level==opt.level) and (opt.faction_id==nil or b.faction_id==opt.faction_id) then out[#out+1]=b end
 end
 table.sort(out,function(a,b)local x,y=a[opt.key or 'skill_id'],b[opt.key or 'skill_id'];if x==y then return a.skill_id&lt;b.skill_id end;if opt.desc then return x&gt;y else return x&lt;y end end)
 return out
end
-- Test-only addition. Existing owned skills are never rewritten.
function E.learningState()
 local c=context();local list=q(c.hero+0x260);local count=int(list+0x18);local version=int(list+0x1C);local array=q(list+0x10)
 check(count&gt;=0 and count&lt;2000,'功法列表长度异常')
 local byID={};local first
 for n=0,count-1 do
  local p=q(array+0x20+n*8);check(cname(p)=='KungfuSkillLvData','功法记录类型不符')
  local r={ptr=p,id=int(p+0x10),equipped=readBytes(p+0x20,1)==1,level=int(p+0x14),fight=flt(p+0x18),book=flt(p+0x1C)}
  check(int(p+0x24)==0 and not byID[r.id],'角色归属或功法ID异常');byID[r.id]=r;first=first or p
 end
 check(same(c,context()) and q(c.hero+0x260)==list and int(list+0x1C)==version,'读档或列表变化，请重试')
 return {context=c,list=list,count=count,version=version,array=array,byID=byID,first=first}
end
function E.prepareCatalogLearn(id)
 check(not E.busy and not E.skillTraining,'已有请求执行中，请等待')
 local s=E.learningState();local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏')
 local prepared={id=id,context=s.context,existing=s.byID[id]}
 if prepared.existing then return prepared end
 check(s.first,'没有现有功法可校验类型')
 prepared.klass=q(s.first)
 prepared.ctor=method(prepared.klass,'.ctor',1,0x7C01E0,base)
 prepared.getSkill=method(q(s.context.hero),'GetSkill',3,0x5CC4B0,base)
 return prepared
end
function E.submitCatalogLearn(prepared,onDone,onProgress)
 check(not E.busy and not E.skillTraining,'已有请求执行中，请等待')
 local s=E.learningState();local c=s.context;local id=prepared.id
 check(c.pid==prepared.context.pid and c.world==prepared.context.world and c.hero==prepared.context.hero,'已切换存档，停止学习')
 if not prepared.remove and s.byID[id] then onDone(true,'该功法已经学会；原等级和经验保持不变。');return end
 check((prepared.remove or (prepared.klass and prepared.ctor)) and prepared.getSkill,'学习预检已失效，请重新选择')
 local _,items=E.snapshot();check(#items&gt;0,'背包为空，无法校验桥接')
 local b=bridge(c,items[1]);local d=b.data;check(int(d)~=1 and int(d)~=2,'桥接仍有请求，禁止重复提交')
 local base=getAddressSafe('GameAssembly.dll')
 for off,v in pairs({[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x50]=prepared.getSkill,[0x68]=0,[0xF0]=b.objectNew,[0x200]=prepared.remove and check(s.byID[id],'武功已经不存在').ptr or 0,[0x208]=d+0x248,[0x210]=d+0x248,[0x220]=d+0x240,[0x300]=s.list,[0x308]=s.array,[0x390]=prepared.klass or 0,[0x398]=prepared.ctor or 0})do check(writeQword(d+off,v),'学习参数写入失败')end
 for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=8,[0x240]=id,[0x248]=0,[0x310]=s.version,[0x314]=s.count,[0x3A0]=0,[0x3A8]=prepared.remove and 1 or 0})do check(writeInteger(d+off,v),'学习参数写入失败')end
 local fresh=E.learningState();check(fresh.list==s.list and fresh.version==s.version and same(c,fresh.context),'提交前数据变化，停止学习')
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100
 local started=getTickCount();local lastSecond=-1;E.busy=true;E.copyTimer=timer
 local finished=false
 local function finish(ok,msg)if finished then return end;finished=true;timer.destroy();E.copyTimer=nil;E.busy=false;onDone(ok,msg)end
 timer.OnTimer=function()
  local ok,err=pcall(function()
   if getOpenedProcessID()~=c.pid then finish(false,'游戏进程已切换，请核对结果。');return end
   local state=readInteger(d)
   if state==1 or state==2 then
    local seconds=math.floor((getTickCount()-started)/1000)
    if seconds~=lastSecond then
     lastSecond=seconds
     if onProgress then onProgress((prepared.remove and '遗忘武功：' or '秘籍已添加；学习')..(state==1 and '等待游戏运行' or ('执行阶段 '..tostring(readInteger(d+0x3A0))))..'，已等待 '..seconds..' 秒。'..(seconds&gt;=15 and '请求尚未结束，禁止重复提交；没有强制清除或自动重试。' or ''))end
    end
    if seconds&gt;=15 then timer.Interval=1000 end
    return
   end
   check(state==3,'学习未成功，桥接状态 '..tostring(state)..'；秘籍已保留，请核对，勿重复添加。')
   local after=E.learningState();check(after.context.hero==c.hero and after.context.world==c.world,'学习后已切换存档，请核对')
   if prepared.remove then
    check(not after.byID[id] and after.count==s.count-1,'遗忘后结果不符，请核对')
    for oldID,old in pairs(s.byID)do if oldID~=id then local now=after.byID[oldID];check(now and now.ptr==old.ptr and now.level==old.level and now.book==old.book and now.fight==old.fight,'其他武功发生变化，请核对')end end
    finish(true,'已遗忘选中武功；背包秘籍保留。');return
   end
   local r=check(after.byID[id],'调用结束但未找到武功，禁止自动重试')
   check(after.count==s.count+1 and r.level==0 and r.book==0 and r.fight==0,'功法已加入，但数量/等级/经验与预期不符，请手动核对')
   for oldID,old in pairs(s.byID)do local now=after.byID[oldID];check(now and now.ptr==old.ptr and now.level==old.level and now.book==old.book and now.fight==old.fight,'已有功法发生变化，请核对')end
   finish(true,'秘籍已添加；主角已学会对应武功：0级、理论0、实战0。未自动装备。')
  end)
  if not ok then finish(false,tostring(err))end
 end
 if not writeInteger(d,1)then finish(false,'请求提交失败');return end;timer.Enabled=true
end
function E.addBookAndLearn(id,version,onDone,onProgress)
 local prepared=E.prepareCatalogLearn(id)
 E.addByID('book',id,function(ok,msg)
  if not ok then onDone(false,'添加失败，未启动学习：'..msg);return end
  local success,err=pcall(E.submitCatalogLearn,prepared,onDone,onProgress)
  if not success then onDone(false,'秘籍已添加；学习未提交：'..tostring(err))end
 end,version)
end

function E.forgetCatalogSkill(id,onDone,onProgress)
 local s=E.learningState();check(s.byID[id],'主角尚未学会此武功')
 local base=check(getAddressSafe('GameAssembly.dll'),'未连接游戏')
 E.submitCatalogLearn({id=id,context=s.context,remove=true,getSkill=method(q(s.context.hero),'LoseSkill',1,0x5D3310,base)},onDone,onProgress)
end

function E.showBookCatalog(onChoose)
 if E.catalogForm then E.catalogForm.show();E.catalogForm.bringToFront();return end
 local f=createForm(false);E.catalogForm=f;f.Caption='秘籍目录 v44 · 本地预览 / 添加';f.Width=1100;f.Height=800;f.Position='poScreenCenter';f.OnClose=function()return caHide or 1 end
 local function lab(s,x,y)local c=createLabel(f);c.Caption=s;c.Left=x;c.Top=y;return c end
 local status
 local function btn(s,x,y,w,fn)local c=createButton(f);c.Caption=s;c.Left=x;c.Top=y;c.Width=w;c.OnClick=function()local ok,err=pcall(fn);if not ok then if status then status.Caption="操作未完成："..tostring(err)end;showMessage(tostring(err))end end;return c end
 lab('搜索名称 / ID / 说明',12,18);local search=createEdit(f);search.Left=175;search.Top=12;search.Width=500
 local filters={};local quiet=false
 for n,s in ipairs({{'type_id','类型'}, {'level','等级'}, {'faction_id','门派'}})do
  local x=12+(n-1)*355;lab(s[2],x,58);local c=createComboBox(f);c.Left=x+45;c.Top=52;c.Width=295;c.Style='csDropDownList';c.Items.add('全部');c.ItemIndex=0;filters[s[1]]={control=c,values={}}
 end
 local view=createListView(f);view.Left=12;view.Top=92;view.Width=1060;view.Height=340;view.ViewStyle='vsReport';view.RowSelect=true;view.ReadOnly=true;view.HideSelection=false
 local specs={{'skill_id','功法 ID',80},{'name','秘籍 / 功法',235},{'type_name','类型',100},{'level_name','等级',100},{'faction_name','门派',180},{'hidden','隐藏配置',100}}
 for _,s in ipairs(specs)do local col=view.Columns.add();col.Caption=s[2];col.Width=s[3] end
 local details=createMemo(f);details.Left=12;details.Top=445;details.Width=850;details.Height=190;details.ReadOnly=true;details.ScrollBars='ssVertical';details.WordWrap=true
 local picture=createImage(f);picture.Left=882;picture.Top=445;picture.Width=190;picture.Height=190;picture.Stretch=false;picture.Visible=false
 status=lab('请加载 LongYinLiZhiZhuan-books.json。',12,730);status.Width=1060
 local visible,selected={},nil;local key,desc='skill_id',false
 local function draw()
  if quiet then return end
  local opt={search=search.Text,key=key,desc=desc};for k,v in pairs(filters)do opt[k]=v.values[v.control.ItemIndex]end
  visible=E.filterBooks(E.bookCatalog and E.bookCatalog.books or {},opt);selected=nil;details.Lines.Text='';picture.Visible=false;quiet=true
  view.beginUpdate()
  local ok,err=pcall(function()
   view.Items.clear();view.ItemIndex=-1
   for _,b in ipairs(visible)do local row=view.Items.add();row.Caption=tostring(b.skill_id);for n=2,#specs do local k=specs[n][1];row.SubItems.add(k=='hidden' and (b.hidden and '是' or '') or tostring(b[k]))end end
  end)
  view.endUpdate();quiet=false;check(ok,tostring(err))
  status.Caption=string.format('目录 %d 条，显示 %d 条；选择查看文字说明；添加时核对当前游戏。',E.bookCatalog and #E.bookCatalog.books or 0,#visible)
 end
 local function populate()
  quiet=true
  for k,v in pairs(filters)do
   local labels,ids={},{};local labelKey=({type_id='type_name',level='level_name',faction_id='faction_name'})[k]
   for _,b in ipairs(E.bookCatalog.books)do if not labels[b[k]]then ids[#ids+1]=b[k];labels[b[k]]=b[labelKey]end end
   table.sort(ids);v.values=ids;v.control.Items.clear();v.control.Items.add('全部');for _,id in ipairs(ids)do v.control.Items.add(labels[id]..' ('..id..')')end;v.control.ItemIndex=0
  end
  quiet=false;draw()
 end
 local function loadPicture(b)
  picture.Visible=false
  if not b or not E.bookCatalogPath then return end
  local dir=E.bookCatalogPath:match('^(.*[/\\])') or ''
  local ok=pcall(function()picture.Picture.loadFromFile(dir..'book-ranges/'..b.skill_id..'.png')end)
  picture.Visible=ok
  status.Caption=ok and ('已选「'..b.name..'」；本地图片预览。') or ('已选「'..b.name..'」；未找到图片，请运行 Generate-BookRanges.ps1。')
 end
 local function choose()
  if quiet then return end
  local nextBook=visible[view.ItemIndex+1];if selected==nextBook then return end;selected=nextBook
  details.Lines.Text=selected and string.format('%s · 功法 ID %d\r\n%s / %s / %s%s\r\n\r\n%s',selected.name,selected.skill_id,selected.type_name,selected.level_name,selected.faction_name,selected.hidden and ' / 隐藏配置' or '',selected.description..'\r\n\r\n'..(E.skillEffectText[selected.skill_id] or '效果配置未收录')..'\r\n\r\n蓝：可选目标；红：作用格；紫：重叠。定向范围显示各朝向并集，深红仅为单一朝向示例，不是四向同时命中。\r\n基础配置，不含人物加成与地形；最多中心±10格。') or ''
  loadPicture(selected)
 end
 view.OnClick=choose;view.OnSelectItem=function(_,_,yes)if yes then choose()end end
 view.OnColumnClick=function(_,col)local k=specs[col.Index+1][1];if k=='hidden'then return end;if key==k then desc=not desc else key=k;desc=false end;draw()end
 search.OnChange=draw;for _,v in pairs(filters)do v.control.OnChange=draw end
 btn('加载 JSON',700,10,160,function()
  local dialog=createOpenDialog(f);dialog.Filter='JSON 文件 (*.json)|*.json';local ok,path=pcall(function()if dialog.execute()then return dialog.FileName end end);dialog.destroy();if not ok then error(path)end
  if path then E.loadBookCatalog(path);populate()end
 end)
 btn('清除筛选',880,10,170,function()quiet=true;search.Text='';for _,v in pairs(filters)do v.control.ItemIndex=0 end;quiet=false;draw()end)
 btn('填入添加栏',12,650,180,function()choose();check(selected,'请选择一本秘籍');onChoose(selected);status.Caption='已填入「'..selected.name..'」，请在主窗口选择版本后添加。'end)
 local version=createComboBox(f);version.Left=210;version.Top=650;version.Width=150;version.Style='csDropDownList'
 for _,name in ipairs({'残本','仿本','善本','古本','珍本','完本'})do version.Items.add(name)end;version.ItemIndex=5
 local function selectedID()choose();check(selected,'请选择一本秘籍');local c=E.creationLookup('book',selected.skill_id,version.ItemIndex);check(c.name==selected.name,'JSON与当前游戏名称不一致，请核对目录');return selected.skill_id end
 local function done(ok,msg)status.Caption=msg;if not ok then showMessage(msg)end end
 btn('添加秘籍 ×1',375,650,150,function()local id=selectedID();E.addByID('book',id,done,version.ItemIndex);status.Caption='已提交添加，请保持游戏运行。'end)
 btn('添加＋学会 0级（测试）',540,650,310,function()local id=selectedID();status.Caption='准备添加和学习，请保持游戏运行。';E.addBookAndLearn(id,version.ItemIndex,done,function(msg)status.Caption=msg end)end)
 btn('重新加载图片',880,650,170,function()choose();check(selected,'请选择一本秘籍');loadPicture(selected)end)
 lab('新学武功为 0级、0经验；已有武功不降级。遗忘请到主角武功界面。',12,695)
 if E.bookCatalog then populate()end;f.show()
end

function E.tagSnapshot()
 local c=context();local list=q(c.hero+0x368);local count=int(list+0x18);check(count&gt;=0 and count&lt;1000,'天赋列表异常')
 local array=q(list+0x10);local version=int(list+0x1C)
 local manager=q(q(q(getAddressSafe('GameAssembly.dll')+0x1E528F8)+0xB8)+0x20)
 local dict=q(manager+0x1A8);local entries=q(dict+0x18);local n=int(dict+0x20);check(n&gt;=0 and n&lt;10000,'天赋配置异常')
 local catalog,byID={},{}
 for i=0,n-1 do local e=entries+0x20+i*24;if int(e)&gt;=0 then
  local p=q(e+16);local id=int(e+8);check(int(p+0x10)==id,'天赋配置 ID 不符')
  local t={id=id,name=str(q(p+0x18)),category=str(q(p+0x50)),value=int(p+0x20),meaning=str(readQword(p+0x28)),opposite=str(readQword(p+0x30))}
  byID[id]=t;if t.category~='特效' then catalog[#catalog+1]=t end
 end end
 table.sort(catalog,function(a,b)return a.id&lt;b.id end)
 local owned,permanent={},0
 for i=0,count-1 do local p=q(array+0x20+i*8);local id=int(p+0x10);local t=check(byID[id],'天赋配置缺失')
  local time=flt(p+0x14);owned[#owned+1]={id=id,name=t.name,category=t.category,time=time,ptr=p};if time&lt;0 then permanent=permanent+1 end
 end
 check(same(c,context()) and q(c.hero+0x368)==list and int(list+0x1C)==version,'读取期间数据变化，请刷新')
 return {context=c,list=list,array=array,version=version,count=count,owned=owned,catalog=catalog,byID=byID,permanent=permanent,points=flt(c.hero+0x364)}
end
function E.changeTag(previous,id,adding,onDone)
 check(not E.busy,'已有请求执行中，请等待')
 local s=E.tagSnapshot();local c=s.context
 check(same(previous.context,c) and s.list==previous.list and s.version==previous.version and s.count==previous.count,'天赋或存档已变化，请刷新重新选择')
 local tag=check(s.byID[id],'未找到该天赋');local matches=0
 for _,t in ipairs(s.owned)do if t.id==id then matches=matches+1;check(t.time&lt;0,'临时效果不在本功能删除范围')end end
 check(adding and matches==0 or not adding and matches==1,adding and '已拥有该天赋' or '目标天赋缺失或重复')
 check(not adding or tag.category~='特效','不能将临时特效添加为永久天赋')
 local _,items=E.snapshot();check(#items&gt;0,'背包至少需要一件物品以校验桥接版本')
 local b=bridge(c,items[1]);local d=b.data;check(int(d)~=1 and int(d)~=2,'原生请求仍在执行')
 local base=getAddressSafe('GameAssembly.dll');local klass=q(c.hero)
 local target=adding and method(klass,'AddTag',5,0x5B34E0,base) or method(klass,'RemoveTag',2,0x5DA8C0,base)
 local max=method(klass,'GetMaxTagNum',0,0x5C7DC0,base);local num=method(klass,'GetHeroPermanentTagNum',0,0x5C5CA0,base)
 local values={[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x50]=target,[0x68]=0,[0xC8]=d+0x200,[0x300]=s.list,[0x308]=s.array,[0x320]=max,[0x328]=num,[0x200]=d+0x240,[0x208]=d+0x248}
 for off,v in pairs(values)do check(writeQword(d+off,v),'参数写入失败')end
 for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=3,[0x310]=s.version,[0x314]=s.count,[0x318]=adding and 1 or 0,[0x240]=id})do check(writeInteger(d+off,v),'参数写入失败')end
 if adding then
  check(writeFloat(d+0x248,-1) and writeInteger(d+0x258,0) and writeInteger(d+0x260,1),'添加参数写入失败')
  check(writeQword(d+0x210,q(c.hero+0x78)) and writeQword(d+0x218,d+0x258) and writeQword(d+0x220,d+0x260),'添加参数表写入失败')
 else check(writeInteger(d+0x248,0),'删除参数写入失败')end
 local latest=E.tagSnapshot();check(latest.list==s.list and latest.version==s.version and same(latest.context,c),'提交前数据变化，请刷新')
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100;E.busy=true;E.copyTimer=timer
 timer.OnTimer=function()
  local state=getOpenedProcessID()==c.pid and readInteger(d) or -1
  if state==1 or state==2 then return end
  timer.destroy();E.copyTimer=nil;E.busy=false
  local ok,msg=pcall(function()
   check(state==3,({[4]='存档、背包或天赋发生变化，未执行，请刷新。',[5]='游戏方法异常，请检查结果，不要重复点击。',[7]='永久天赋已达上限，请先删除一个再添加。'})[state] or '请求未完成，请检查游戏进程')
   local after=E.tagSnapshot();check(after.context.hero==c.hero and after.context.world==c.world,'已切换存档，请手动核对')
   local found=0;for _,t in ipairs(after.owned)do if t.id==id then found=found+1 end end
   check(found==(adding and 1 or 0),'结果未符合预期，请检查列表，勿自动重试')
   check(after.count==s.count+(adding and 1 or -1),'天赋列表另有变化，请检查完整列表')
   return (adding and '已添加「' or '已删除「')..tag.name..'」。永久天赋 '..after.permanent..'，天赋点 '..after.points..'（操作前 '..s.points..'）。关闭再打开游戏天赋页刷新。'
  end)
  onDone(ok,tostring(msg))
 end
 if not writeInteger(d,1)then timer.destroy();E.copyTimer=nil;E.busy=false;error('提交请求失败')end
 timer.Enabled=true
end
function E.showTags()
 if E.tagForm then E.tagForm.show();E.tagForm.bringToFront();if E.refreshTags and not E.busy then E.refreshTags()end;return end
 local f=createForm(false);E.tagForm=f;f.Caption='主角天赋 · 添加 / 删除';f.Width=1100;f.Height=760;f.Position='poScreenCenter';f.OnClose=function()return caHide or 1 end
 local function label(s,x,y)local a=createLabel(f);a.Caption=s;a.Left=x;a.Top=y;return a end
 local function btn(s,x,y,w,fn)local a=createButton(f);a.Caption=s;a.Left=x;a.Top=y;a.Width=w;a.OnClick=function()local ok,err=pcall(fn);if not ok then showMessage(tostring(err))end end;return a end
 label('已拥有（临时效果标注剩余时间）',12,14);label('可选永久天赋 · 搜索名称 / 分类 / ID',460,14)
 local search=createEdit(f);search.Left=460;search.Top=40;search.Width=405;search.Text=''
 local function view(x,y,w)local v=createListView(f);v.Left=x;v.Top=y;v.Width=w;v.Height=430;v.ViewStyle='vsReport';v.RowSelect=true;v.ReadOnly=true;v.HideSelection=false;for _,c in ipairs({{'ID',55},{'天赋',145},{'分类',80},{'状态',115}})do local col=v.Columns.add();col.Caption=c[1];col.Width=c[2]end;return v end
 local owned=view(12,80,425);local all=view(460,80,610)
 local detail=createMemo(f);detail.Left=12;detail.Top=525;detail.Width=1058;detail.Height=85;detail.ReadOnly=true;detail.WordWrap=true
 local status=label('刷新读取主角天赋。',12,690);status.Width=1058
 label('直接添加不扣点；删除不退点。添加遵守游戏槽位上限，临时效果不可在此删除。',12,620)
 local snapshot,choices,selectedOwned,selectedNew;local quiet=false
 local function showDetail(t)
  if not t then return end
  local cfg=snapshot.byID[t.id];detail.Lines.Text=cfg.name..'（ID '..cfg.id..'）\r\n分类：'..cfg.category..'　配置等级：'..cfg.value..'\r\n同系：'..cfg.meaning..'　相反：'..cfg.opposite
 end
 local function drawChoices()
  if not snapshot or quiet then return end;quiet=true;all.Items.clear();all.ItemIndex=-1;choices={};selectedNew=nil
  local have={};for _,t in ipairs(snapshot.owned)do have[t.id]=true end
  local term=search.Text or ''
  for _,t in ipairs(snapshot.catalog)do if (t.name..' '..t.category..' '..t.id):find(term,1,true)then
   choices[#choices+1]=t;local row=all.Items.add();row.Caption=tostring(t.id);row.SubItems.add(t.name);row.SubItems.add(t.category);row.SubItems.add(have[t.id] and '已拥有' or '可选择')
  end end;quiet=false
 end
 local function refresh()
  check(not E.busy,'操作执行中，请等待');snapshot=E.tagSnapshot();quiet=true;owned.Items.clear();owned.ItemIndex=-1;selectedOwned=nil;detail.Lines.Text=''
  for _,t in ipairs(snapshot.owned)do local row=owned.Items.add();row.Caption=tostring(t.id);row.SubItems.add(t.name);row.SubItems.add(t.category);row.SubItems.add(t.time&lt;0 and '永久' or ('临时 '..t.time))end
  quiet=false;drawChoices();status.Caption='永久天赋 '..snapshot.permanent..'；天赋点 '..snapshot.points..'；目录 '..#snapshot.catalog..' 项。'
 end
 E.refreshTags=refresh
 owned.OnClick=function()if quiet then return end;selectedOwned=snapshot.owned[owned.ItemIndex+1];showDetail(selectedOwned)end
 all.OnClick=function()if quiet then return end;selectedNew=choices[all.ItemIndex+1];showDetail(selectedNew)end
 owned.OnSelectItem=function(_,_,yes)if yes then owned.OnClick()end end;all.OnSelectItem=function(_,_,yes)if yes then all.OnClick()end end
 search.OnChange=drawChoices;btn('刷新',890,38,180,refresh)
 local function submit(t,adding)
  check(t,adding and '请选择右侧天赋' or '请选择左侧已拥有的永久天赋')
  E.changeTag(snapshot,t.id,adding,function(ok,msg)local success,err=pcall(refresh);status.Caption=msg;if not ok or not success then showMessage(msg..(success and '' or ('\n'..tostring(err))))end end)
  status.Caption='请求已提交，请回游戏运行一帧；完成前不要读档或重复点击。'
 end
 btn('删除左侧选中天赋',12,650,225,function()submit(selectedOwned,false)end)
 btn('添加右侧选中天赋',460,650,225,function()submit(selectedNew,true)end)
 f.show();local ok,err=pcall(refresh);if not ok then status.Caption=tostring(err)end
end


-- Owned kungfu records; experience changes run through the game's main thread.
function E.skillSnapshot()
 local c=context();local list=q(c.hero+0x260);local count=int(list+0x18)
 check(count&gt;=0 and count&lt;2000,'功法列表长度异常')
 local array=q(list+0x10);local version=int(list+0x1C)
 local base=getAddressSafe('GameAssembly.dll');local manager=q(q(q(base+0x1E528F8)+0xB8)+0x20)
 local dict=q(manager+0x138);local entries=q(dict+0x18);local total=int(dict+0x20)
 check(total&gt;=0 and total&lt;20000,'功法配置异常');local cfg={}
 for n=0,total-1 do local e=entries+0x20+n*24;local hash=int(e)
  if hash&gt;=0 and hash&lt;0x80000000 then local p=q(e+16);local id=int(e+8)
   check(int(p+0x14)==id,'功法配置 ID 不一致')
   cfg[id]={name=plain(str(q(p+0x20))),description=plain(str(readQword(p+0x28)))..'\r\n\r\n'..(E.skillEffectText[id] or '效果配置未收录'),rarity=int(p+0x34)}
  end
 end
 -- Save-specific skills are stored separately from the shipped catalog.
 local custom=readQword(c.world+0x268)
 if custom and custom~=0 then
  local cn=int(custom+0x20)
  check(cn&gt;=0 and cn&lt;20000,'自创功法配置异常')
  local ce=cn&gt;0 and q(custom+0x18) or 0
  for n=0,cn-1 do
   local entry=ce+0x20+n*24;local hash=int(entry)
   if hash&gt;=0 and hash&lt;0x80000000 then
    local id=int(entry+8);local wrapper=q(entry+16);local p=q(wrapper+0x10)
    check(cname(p)=='KungfuSkillData' and int(p+0x14)==id,'自创功法配置 ID 不一致')
    cfg[id]={name=plain(str(q(p+0x20)))..' [自创]',description=plain(str(readQword(p+0x28)))..'\r\n\r\n自创功法 ID：'..id..'\r\n基础伤害：'..flt(p+0x3C)..'  内力消耗：'..flt(p+0x38),rarity=int(p+0x34)}
   end
  end
 end
 local rows={}
 for n=0,count-1 do local p=q(array+0x20+n*8);check(cname(p)=='KungfuSkillLvData','功法记录类型不符')
  local id=int(p+0x10);local data=check(cfg[id],'未找到功法配置 ID：'..id)
  check(int(p+0x24)==0,'功法不属于主角')
  rows[#rows+1]={ptr=p,index=n,id=id,name=data.name,description=data.description,rarity=data.rarity,equipped=readBytes(p+0x20,1)==1,level=int(p+0x14),book=flt(p+0x1C),fight=flt(p+0x18)}
 end
 check(same(c,context()) and q(c.hero+0x260)==list and q(list+0x10)==array and int(list+0x1C)==version,'读取期间功法变化，请刷新')
 return {context=c,list=list,array=array,count=count,version=version,rows=rows}
end
function E.orderSkills(snapshot)
 local c=snapshot.context;local key=c.pid..':'..c.world..':'..c.hero
 local h=E.skillHistory
 if not h or h.key~=key then h={key=key,rows={},clock=0,initialized=false};E.skillHistory=h end
 local out,seen={},{}
 for _,r in ipairs(snapshot.rows)do
  local old=h.rows[r.id];local changed=(old and (old.level~=r.level or old.book~=r.book or old.fight~=r.fight)) or (not old and h.initialized)
  local rank=old and old.rank or 0
  if changed then h.clock=h.clock+1;rank=h.clock end
  seen[r.id]={level=r.level,book=r.book,fight=r.fight,rank=rank};out[#out+1]=r
 end
 h.rows=seen;h.initialized=true
 table.sort(out,function(a,b)
  local am,bm=a.level&gt;=10,b.level&gt;=10;if am~=bm then return not am end
  local ar,br=seen[a.id].rank,seen[b.id].rank;if ar~=br then return ar&gt;br end
  return a.index&lt;b.index
 end)
 return out
end

function E.addSkillExperience(previous,selected,kind,amount,onDone,owner)
 check(not E.busy,'已有请求执行中，请等待')
 check(not E.skillTraining or E.skillTraining==owner,'一键修炼执行中，请先停止')
 check(kind=='book' or kind=='fight','经验类型无效')
 check(type(amount)=='number' and amount==amount and amount&gt;0 and amount&lt;=100000,'请输入大于 0、至多 100000 的经验值')
 local s=E.skillSnapshot();local c=s.context
 check(same(c,previous.context) and s.list==previous.list and s.array==previous.array and s.version==previous.version and s.count==previous.count,'存档或功法列表变化，请刷新')
 local target=s.rows[selected.index+1]
 check(target and target.ptr==selected.ptr and target.id==selected.id,'选中功法已变化，请刷新')
 check(target.level&lt;10,'该功法已达到 10 级')
 local _,items=E.snapshot();check(#items&gt;0,'背包至少需要一件物品以校验桥接版本')
 local b=bridge(c,items[1]);local d=b.data;check(int(d)~=1 and int(d)~=2,'原生请求仍在执行')
 local base=getAddressSafe('GameAssembly.dll')
 local fn=method(q(c.hero),kind=='book' and 'AddSkillBookExp' or 'AddSkillFightExp',3,kind=='book' and 0x5B2690 or 0x5B2B30,base)
 for off,v in pairs({[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x50]=fn,[0x68]=0,[0xC8]=d+0x200,[0x200]=d+0x240,[0x208]=target.ptr,[0x210]=d+0x248,[0x300]=s.list,[0x308]=s.array,[0x330]=0x20+target.index*8,[0x338]=target.ptr})do check(writeQword(d+off,v),'参数写入失败')end
 for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=4,[0x248]=0,[0x310]=s.version,[0x314]=s.count,[0x340]=target.id})do check(writeInteger(d+off,v),'参数写入失败')end
 check(writeFloat(d+0x240,amount),'经验参数写入失败')
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100;E.busy=true;E.copyTimer=timer
 timer.OnTimer=function()
  local state=getOpenedProcessID()==c.pid and readInteger(d) or -1
  if state==1 or state==2 then return end
  timer.destroy();E.copyTimer=nil;E.busy=false
  local ok,msg=pcall(function()
   check(state==3,({[4]='存档或列表已变化，请刷新后重试。',[5]='游戏接口发生异常，请检查结果，勿重复点击。'})[state] or '请求未完成，请检查游戏进程')
   local after=E.skillSnapshot();check(after.context.world==c.world and after.context.hero==c.hero,'已切换存档，请手动核对')
   local found;for _,r in ipairs(after.rows)do if r.id==target.id and r.ptr==target.ptr then found=r;break end end
   check(found,'操作后功法记录变化，请手动核对')
   return string.format('%s：等级 %d → %d；理论 %.2f → %.2f；实战 %.2f → %.2f。倍率、经验转换及瓶颈由游戏处理。',found.name,target.level,found.level,target.book,found.book,target.fight,found.fight)
  end)
  onDone(ok,tostring(msg))
 end
 if not writeInteger(d,1)then timer.destroy();E.copyTimer=nil;E.busy=false;error('请求提交失败')end
 timer.Enabled=true
end
function E.skillObstacleLevels(rarity)
 check(type(rarity)=='number' and rarity&gt;=0 and rarity&lt;=5,'功法档次异常')
 local base=getAddressSafe('GameAssembly.dll');local st=q(q(base+0x1E538E8)+0xB8)
 local list=q(st+0x660);check(int(list+0x18)&gt;rarity,'突破配置缺失')
 local levels=q(q(list+0x10)+0x20+rarity*8);local count=int(levels+0x18)
 check(count&gt;=0 and count&lt;=10,'突破配置数量异常');local result={}
 for n=0,count-1 do local v=int(q(levels+0x10)+0x20+n*4);check(v&gt;=0 and v&lt;10,'突破等级异常');result[#result+1]=v end
 table.sort(result);return result
end
function E.trainSkillToObstacle(previous,selected,onDone,onProgress)
 check(not E.busy and not E.skillTraining,'已有请求执行中，请等待')
 check(selected and selected.level&lt;10,'请选择未满级的武功')
 local goal=10;for _,lv in ipairs(E.skillObstacleLevels(selected.rarity))do if lv&gt;=selected.level then goal=lv;break end end
 local token={cancel=false};E.skillTraining=token
 local calls=0;local beforePair;local finished=false
 local function finish(ok,msg)if finished then return end;finished=true;E.skillTraining=nil;onDone(ok,msg)end
 local function current()
  local s=E.skillSnapshot();check(s.context.pid==previous.context.pid and s.context.world==previous.context.world and s.context.hero==previous.context.hero,'已读档或切换角色，一键修炼已停止')
  local r;for _,row in ipairs(s.rows)do if row.id==selected.id and row.ptr==selected.ptr then r=row;break end end
  check(r,'功法记录已变化，一键修炼已停止');return s,r
 end
 local step
 step=function(kind)
  local ok,err=pcall(function()
   if token.cancel then finish(true,'已停止一键修炼；已经完成的经验保留。');return end
   local s,r=current()
   if r.level&gt;=10 then finish(true,r.name..' 已达到10级。');return end
   check(r.level&lt;=goal,'等级已越过本次目标，停止后续请求，请核对游戏')
   if kind=='book' then beforePair={level=r.level,book=r.book,fight=r.fight}end
   check(calls&lt;80,'已达到本次修炼次数上限，停止；请检查经验倍率和游戏条件')
   calls=calls+1
   if onProgress then onProgress(r.name..'：当前 '..r.level..' 级，目标 '..goal..' 级突破关口；正在补'..(kind=='book' and '理论' or '实战')..'经验。')end
   E.addSkillExperience(s,r,kind,100000,function(success,msg)
    if not success then finish(false,msg);return end
    local good,problem=pcall(function()
     local _,after=current()
     if token.cancel then finish(true,'已停止一键修炼；已提交的一次请求已完成。');return end
     if after.level&gt;=10 then finish(true,after.name..' 已达到10级。');return end
     if kind=='book' then step('fight');return end
     local unchanged=after.level==beforePair.level and equal(after.book,beforePair.book) and equal(after.fight,beforePair.fight)
     if unchanged then
      if after.level==goal then finish(true,after.name..' 已停在 '..goal..' 级突破关口，经验不再增加；请在游戏中完成突破。')
      else finish(false,'经验和等级未继续增长，已停止；请检查游戏修炼条件或经验倍率。')end
      return
     end
     step('book')
    end)
    if not good then finish(false,tostring(problem))end
   end,token)
  end)
  if not ok then finish(false,tostring(err))end
 end
 -- Refuse a stale selection before scheduling the first native call.
 local ok,err=pcall(function()local s,r=current();check(same(s.context,previous.context) and r.level==selected.level and s.list==previous.list and s.array==previous.array and s.version==previous.version,'选择已过期，请刷新后重新选择')end)
 if not ok then finish(false,tostring(err));return end
 step('book')
end
do
local function withBreakthroughGame(action)
if LongYiCustomCallBusy or LongYiBreakthroughCallBusy then error("上次调用尚未完成")end
local function check(v,s)if not v then error(s,2)end;return v end
local function q(a)return check(readQword(a),'指针不可读')end
local function int(a)return check(readInteger(a),'数据不可读')end
local function cstr(a)return readString(a,180) or ''end
local function ustr(a)if a==0 then return ''end;local n=int(a+16);check(n&lt;4096,'文字长度异常');return readString(a+20,n*2,true) or ''end
local function classname(p)return cstr(q(q(p)+16))end
local pid=getOpenedProcessID();local base=check(getAddressSafe('GameAssembly.dll'),'请连接游戏并读入存档')
local update=base+0x18B9460;local original=readBytes(update,6,true);check(original and #original==6,'Update 不可读')
local function matches(a,b)if not a or not b or #a~=#b then return false end;for n=1,#a do if a[n]~=b[n]then return false end end;return true end
local chain
if not matches(original,{0x40,0x53,0x48,0x83,0xEC,0x40})then
 for _,name in ipairs({'LongYiItemBridgeV13','LongYiItemBridgeV12','LongYiItemBridgeV11','LongYiItemBridgeV10'})do
  local b=_G[name]
  if b and b.pid==pid and b.base==base and matches(original,b.patch)then
   check(int(b.data)~=1 and int(b.data)~=2,'请等当前物品操作结束');chain=b.mem;break
  end
 end
 check(chain,'Update 被其他脚本修改；请先停用冲突脚本或重启游戏，未覆盖原入口')
end
local pe=int(base+0x3C);local e=base+int(base+pe+0x88);local exports={}
for n=0,int(e+0x18)-1 do
 local name=cstr(base+int(base+int(e+0x20)+n*4))
 if name:find('il2cpp_',1,true)==1 then local ord=readSmallInteger(base+int(e+0x24)+n*2);exports[name]=base+int(base+int(e+0x1C)+ord*4)end
end
local function method(obj,name,argc,rva)
 local k=q(obj)
 while k~=0 do
  local tab=q(k+0x98)
  for n=0,2047 do
   local m=readQword(tab+n*8);if not m or m==0 or readQword(m+24)~=k then break end
   if cstr(q(m+16))==name and readBytes(m+0x4A,1)==argc and q(m)~=0 and (not rva or q(m)==base+rva)then return m end
  end
  k=q(k+0x58)
 end
 error('找不到接口：'..name)
end
LongYiBreakthroughCallBusy=true
local mem=allocateMemory(0x10000,update)
if not mem then LongYiBreakthroughCallBusy=nil;error('无法分配临时调用区')end
local d=mem+0x2000;local cursor=mem+0x3000;local handles={};local attached=false;local patch;local created
local regs={'rax','rcx','rdx','rbx','rbp','rsi','rdi','r8','r9','r10','r11','r12','r13','r14','r15'}
local asm={'label(done)','label(noroot)',string.format('%X:',mem),'pushfq'}
for _,r in ipairs(regs)do asm[#asm+1]='push '..r end
asm[#asm+1]='sub rsp,A8'
for n=0,5 do asm[#asm+1]=string.format('movdqu [rsp+%X],xmm%d',n==0 and 0x80 or 0x20+n*16,n)end
asm[#asm+1]=string.format([[
mov rbx,%X
cmp dword ptr [rbx],1
jne done
mov dword ptr [rbx],2
mov rcx,[rbx+18]
mov rdx,[rbx+20]
mov r8,[rbx+28]
mov r9,[rbx+30]
mov rax,[rbx+38]
mov [rsp+20],rax
mov rax,[rbx+10]
call rax
mov [rbx+8],rax
cmp dword ptr [rbx+48],1
jne noroot
mov rcx,rax
xor edx,edx
mov rax,%X
call rax
mov [rbx+40],eax
noroot:
mov dword ptr [rbx],3
done:]],d,check(exports.il2cpp_gchandle_new,'缺少 IL2CPP 导出'))
for n=0,5 do asm[#asm+1]=string.format('movdqu xmm%d,[rsp+%X]',n,n==0 and 0x80 or 0x20+n*16)end
asm[#asm+1]='add rsp,A8'
for n=#regs,1,-1 do asm[#asm+1]='pop '..regs[n]end
asm[#asm+1]='popfq'
asm[#asm+1]=chain and string.format('jmp %X',chain) or string.format('push rbx\nsub rsp,40\njmp %X',update+6)
local function call(fn,args,root)
 check(int(d)~=2,'上一次调用尚未完成')
 writeQword(d+8,0);writeQword(d+16,fn)
 for n=1,5 do writeQword(d+0x10+n*8,args and args[n] or 0)end
 writeInteger(d+0x48,root and 1 or 0);writeInteger(d,1)
 local start=getTickCount()
 while int(d)~=3 do
  if getTickCount()-start&gt;5000 then if int(d)==1 then writeInteger(d,0)end;error('游戏未完成调用；请回到游戏运行，不要重复勾选')end
  sleep(10);processMessages()
 end
 if root then handles[#handles+1]=int(d+0x40)end
 return q(d+8)
end
local function blob(bytes)
 local a=cursor;cursor=math.floor((cursor+#bytes+15)/16)*16;check(cursor&lt;mem+0x10000,'临时参数区已满')
 check(writeBytes(a,bytes),'参数写入失败');return a
end
local function number(v)local a=blob({0,0,0,0,0,0,0,0});writeInteger(a,v);return a end
local function vector(values)local bytes={};for _=1,#values*4 do bytes[#bytes+1]=0 end;local a=blob(bytes);for n,v in ipairs(values)do writeFloat(a+(n-1)*4,v)end;return a end
local function str(s)local a={s:byte(1,#s)};a[#a+1]=0;return call(exports.il2cpp_string_new,{blob(a)},true)end
local function invoke(m,obj,args)
 local a=0;if args and #args&gt;0 then local bytes={};for _=1,#args*8 do bytes[#bytes+1]=0 end;a=blob(bytes);for n,v in ipairs(args)do writeQword(a+(n-1)*8,v)end end
 local ex=blob({0,0,0,0,0,0,0,0});local result=call(exports.il2cpp_runtime_invoke,{m,obj,a,ex});check(q(ex)==0,'游戏接口报告异常');return result
end
local function invokeNamed(obj,name,args,rva)return invoke(method(obj,name,args and #args or 0,rva),obj,args)end
local function transform(go)return invokeNamed(go,'get_transform')end
local function getgo(tr)return invokeNamed(tr,'get_gameObject')end
local function getchild(tr,n)return invokeNamed(tr,'GetChild',{number(n)})end
local function count(tr)return int(invokeNamed(tr,'get_childCount')+16)end
local ok,err=pcall(function()
 check(autoAssemble(table.concat(asm,'\n')),'临时调用代码编译失败')
 check(math.abs(mem-update)&lt;0x7FFFFFF0,'临时调用区距离过远')
 check(matches(readBytes(update,6,true),original),'入口已变化')
 check(autoAssemble(string.format('%X:\njmp %X\nnop',update,mem)),'临时入口安装失败');attached=true;patch=readBytes(update,6,true)
 action(invokeNamed,number,str,function(v)return vector({v})end,invoke)
end)
if attached and int(d)~=2 then
 for _,h in ipairs(handles)do pcall(call,exports.il2cpp_gchandle_free,{h})end
 if matches(readBytes(update,6,true),patch)then writeBytes(update,original)else ok=false;err='入口已变化，未覆盖其他脚本'end
elseif attached then ok=false;err=tostring(err)..'；调用仍在执行，保留临时调用区，勿重复操作'end
-- Scratch pages remain until process exit so no returning game frame uses freed code.
LongYiBreakthroughCallBusy=nil
if not ok then error(err)end

end


-- Direct reward selection: intentionally never call RealStartBreakThrough or StartBreakThroughButtonClicked.
E.callSectNative=withBreakthroughGame
function E.directBreakthrough(previous,selected)
 check(not E.busy and not E.skillTraining,'请先等待或停止一键修炼')
 check(selected,'请先选择一门武功')
 local state=E.learningState();local c=state.context;local r=check(state.byID[selected.id],'武功已不存在，请刷新')
 check(same(c,previous.context) and r.ptr==selected.ptr and r.level==selected.level,'选择已过期，请刷新后重新选择')
 check(r.level&lt;10,'这门武功已满级')
 local base=check(getAddressSafe('GameAssembly.dll'),'请连接游戏')
 E.recoverCurrentBridge(base,base+0x18B9460,c.pid)
 E.busy=true
 local ok,err=pcall(function()
  withBreakthroughGame(function(native,number,str)
   local function invoke(obj,name,args,rva)
    check(same(c,context()),'读档或角色已变化，停止突破')
    return native(obj,name,args,rva)
   end
   local function yes(p)return p and p~=0 and readBytes(p+16,1)==1 end
   local ctrl=q(q(q(base+0x1E937B0)+0xB8)+8)
   check(ctrl~=0 and cname(ctrl)=='BreakThroughController' and q(ctrl+16)~=0,'突破面板尚未初始化')
   local panel=q(ctrl+0x20);local active=yes(invoke(panel,'get_activeSelf'))
   local tr=invoke(panel,'get_transform')
   local question=invoke(tr,'Find',{str('BreakThroughQuestion')})
   check(question~=0,'突破面板结构已变化')
   if active then
    check(not yes(invoke(invoke(question,'get_gameObject'),'get_activeSelf')),'已有突破奖励，请先在游戏中选择')
    check(not yes(invoke(ctrl,'IsInvoking',{str('SetAllBreakChoiceAvailable')})),'正在显示突破奖励，请勿重复点击')
    local pending=E.pendingBreakthrough
    check(not (pending and pending.world==c.world and pending.ptr==q(ctrl+0x18) and pending.level==readInteger(pending.ptr+0x14)),'已有突破奖励，请先在游戏中选择')
    check(q(ctrl+0x18)==r.ptr,'游戏正在准备另一门武功的突破，请先关闭那个面板')
   end
   check(yes(invoke(r.ptr,'SkillMeetObstacleLv',nil,0x7BFEF0)),'还没到突破关口，请先练到突破关口')
   check(yes(invoke(r.ptr,'CanUpgrade',nil,0x7BB8C0)),'经验尚未达标，请先练到突破关口')
   local choices=invoke(r.ptr,'GetBreakThroughAvailableChoice',nil,0x7BC6F0)
   check(choices~=0 and int(choices+0x18)&gt;0,'这门武功没有可选的突破奖励')
   if not active then invoke(ctrl,'StartBreakThrough',{r.ptr,number(0)},0x9FCE70)end
   check(q(ctrl+0x18)==r.ptr,'突破目标不一致，停止')
   invoke(ctrl,'BreakMedCancel',nil,0x9F9BA0)
   invoke(ctrl,'BreakFoodCancel',nil,0x9F9770)
   invoke(ctrl,'BreakBookCancel',nil,0x9F9320)
   local score={};for j=0,3 do score[j]=flt(ctrl+0x40+j*4)end
   local generated=false
   local success,problem=pcall(function()
    check(writeFloat(ctrl+0x40,1000000),'评分写入失败')
    for j=1,3 do check(writeFloat(ctrl+0x40+j*4,0),'评分写入失败')end
    local rarity=invoke(ctrl,'GetMaxRareLv',nil,0x9FA7A0)
    check(rarity~=0 and flt(rarity+16)==5,'未能生成最高档突破，已停止')
    tr=invoke(panel,'get_transform')
    for _,path in ipairs({'StartButton','RateInfo'})do
     local child=invoke(tr,'Find',{str(path)});check(child~=0,'找不到突破准备控件')
     invoke(invoke(child,'get_gameObject'),'SetActive',{number(0)})
    end
    -- Mark before dispatch; if the native result is uncertain, do not generate a second reward set.
    E.pendingBreakthrough={world=c.world,ptr=r.ptr,level=r.level}
    invoke(ctrl,'StartShowBreakChoice',nil,0x9FD6D0);generated=true
   end)
   if same(c,context()) and q(ctrl+0x18)==r.ptr then
    for j=0,3 do writeFloat(ctrl+0x40+j*4,score[j])end
   end
   if not success then error(problem)end
  end)
 end)
 E.busy=nil
 if not ok then error(err)end
 return '已生成红色突破奖励，请回到游戏选择一项。未调用扣天数、药食或钱财的突破流程；选完后刷新武功。'
end

end

function E.stopAutoSkill(reason)
 local t=E.autoSkill;E.autoSkill=nil
 if t then t.cancel=true;if t.timer then t.timer.Enabled=false;t.timer.OnTimer=nil;t.timer.destroy()end end
 if t and E.skillTraining then E.skillTraining.cancel=true end
 if E.autoSkillNotice then E.autoSkillNotice(false,reason or '连续修炼已停止；已提交的一次操作可能仍会完成。')end
end
function E.randomBreakthrough(snapshot,r,token)
 check(E.autoSkill==token and not token.cancel and not token.submitted,'已停止或本次突破已经提交')
 check(not E.busy,'游戏调用尚未完成')
 local base=getAddressSafe('GameAssembly.dll')
 local recovered=E.recoverCurrentBridge(base,base+0x18B9460,snapshot.context.pid)
 if recovered then
  local saved=LongYiItemBridgeV13
  if saved and saved.pid==recovered.pid and saved.base==recovered.base then
   recovered.clone=saved.clone;recovered.add=saved.add;recovered.objectNew=saved.objectNew
  end
  LongYiItemBridgeV13=recovered
 end
 E.busy=true
 local ok,err=pcall(function()
  E.callSectNative(function(native,number,str)
   local function invoke(obj,name,args,rva)
    check(E.autoSkill==token and not token.cancel and same(snapshot.context,context()),'已停止或切换存档')
    return native(obj,name,args,rva)
   end
   local function yes(obj)return obj and obj~=0 and readBytes(obj+16,1)==1 end
   check(int(snapshot.context.hero+0x58)==0,'仅支持主角，防止NPC重复结算突破奖励')
   check(int(r.ptr+0x10)==r.id and int(r.ptr+0x14)==r.level and r.level&lt;10,'突破目标或等级已改变')
   check(yes(invoke(r.ptr,'CanUpgrade',nil,0x7BB8C0)) and yes(invoke(r.ptr,'SkillMeetObstacleLv',nil,0x7BFEF0)),'尚未达到突破关口')
   local choices=invoke(r.ptr,'GetBreakThroughAvailableChoice',nil,0x7BC6F0)
   check(choices and choices~=0 and int(choices+0x18)&gt;0,'此功法没有可用突破效果')
   local ctrl=q(q(q(base+0x1E937B0)+0xB8)+8);local target=readQword(ctrl+0x18)
   check(not target or target==0 or target==r.ptr,'正在突破另一门武功')
   -- Native red rareLv is 5; ForceFunction 14 adds one strength step.
   -- GetMaxRareLv depends on the temporary preparation score, not the rarity cap.
   local strength=5+(yes(invoke(snapshot.context.hero,'HaveForceFunction',{number(14)},0x5CF4C0)) and 1 or 0)
   if target==r.ptr then
    invoke(ctrl,'CancelInvoke',{str('SetAllBreakChoiceAvailable')})
    invoke(q(ctrl+0x20),'SetActive',{number(0)})
   end
   token.submitted={ptr=r.ptr,level=r.level}
   invoke(r.ptr,'AutoManageBreakThrough',{number(strength)},0x7BB4F0)
   invoke(snapshot.context.hero,'UpgradeSkill',{r.ptr},0x5E1AE0)
   check(int(r.ptr+0x14)==r.level+1,'突破已提交但等级异常，停止；不要重复提交')
   if target==r.ptr then writeQword(ctrl+0x18,0)end
  end)
 end)
 E.busy=nil;if not ok then error(err)end
 return true
end
function E.startAutoSkill(previous,selected)
 check(not E.autoSkill and not E.busy and not E.skillTraining,'请先停止其他修炼或等待操作完成')
 check(selected and selected.level&lt;10,'请选择未满级的武功')
 local token={snapshot=previous,id=selected.id,ptr=selected.ptr,name=selected.name,phase='train',cancel=false}
 local function current()
  local s=E.skillSnapshot();check(same(previous.context,s.context),'已读档或切换角色')
  local r;for _,row in ipairs(s.rows)do if row.id==token.id and row.ptr==token.ptr then r=row;break end end
  check(r,'选中的武功已失效');return s,r
 end
 local s,r=current();check(r.level==selected.level,'等级已变化，请刷新后重新选择')
 local base=getAddressSafe('GameAssembly.dll');local ctrl=q(q(q(base+0x1E937B0)+0xB8)+8);local target=readQword(ctrl+0x18)
 check(not target or target==0 or target==r.ptr,'游戏正在突破另一门武功，请先完成或关闭')
 if target==r.ptr then token.phase='choose';token.deadline=getTickCount()+25000 end
 token.timer=createTimer(nil,false);token.timer.Interval=750;E.autoSkill=token
 local function notice(text)if E.autoSkill==token and E.autoSkillNotice then E.autoSkillNotice(true,token.name..'：'..text)end end
 token.timer.OnTimer=function()
  if token.running or token.cancel or E.autoSkill~=token or E.busy or E.skillTraining or LongYiCustomCallBusy or LongYiWarehouseBusy or LongYiBreakthroughCallBusy then return end
  token.running=true
  local ok,err=pcall(function()
   local fresh,row=current()
   if row.level&gt;=10 then E.stopAutoSkill(token.name..' 已满10级，连续修炼完成。');if E.refreshSkills then E.refreshSkills()end;return end
   if token.phase=='verify' then
    if row.level&gt;token.submitted.level then token.submitted=nil;token.phase='train';notice('突破完成，继续修炼。')
    else check(getTickCount()&lt;token.deadline,'突破提交后等级未增加，停止；未重复点击奖励')end
   elseif token.phase=='open' then
    token.phase='choose';token.deadline=getTickCount()+25000;notice('直接结算随机红色突破，无需显示卡片。')
   elseif token.phase=='choose' then
    check(getTickCount()&lt;token.deadline,'等待奖励超时，请在游戏中核对突破面板')
    local choice=E.randomBreakthrough(fresh,row,token)
    if choice=='prepare' then token.phase='open';notice('准备直接结算红色奖励。')
    elseif choice then token.phase='verify';token.deadline=getTickCount()+8000;notice('随机奖励已提交，正在核对等级。')end
   else
    token.phase='training';notice('正在练到下一个突破关口。')
    E.trainSkillToObstacle(fresh,row,function(success,msg)
     if E.autoSkill~=token or token.cancel then return end
     local good,problem=pcall(function()
      check(success,msg);local nextSnapshot,nextRow=current()
      if nextRow.level&gt;=10 then E.stopAutoSkill(token.name..' 已满10级，连续修炼完成。');if E.refreshSkills then E.refreshSkills()end;return end
      token.phase='open';notice('已练到关口，下一步直接结算红色奖励。')
     end)
     if not good then E.stopAutoSkill('连续修炼停止：'..tostring(problem))end
    end,function(msg)if E.autoSkill==token then notice(msg)end end)
   end
  end)
  token.running=false
  if not ok then E.stopAutoSkill('连续修炼停止：'..tostring(err))end
 end
 token.timer.Enabled=true;notice('连续修炼已开启：升级 → 红色突破 → 随机奖励，直到10级。')
end

function E.showSkills()
 if E.skillForm then E.skillForm.show();E.skillForm.bringToFront();if not E.busy then E.refreshSkills()end;return end
 local f=createForm(false);E.skillForm=f;f.Caption='主角武功 v44.8 · 学习 / 修炼 / 原生随机突破';f.Width=960;f.Height=730;f.Position='poScreenCenter';f.OnClose=function()E.stopAutoSkill();return caHide or 1 end
 local function label(s,x,y)local a=createLabel(f);a.Caption=s;a.Left=x;a.Top=y;return a end
 local function btn(s,x,y,w,fn)local a=createButton(f);a.Caption=s;a.Left=x;a.Top=y;a.Width=w;a.OnClick=function()local ok,err=pcall(fn);if not ok then showMessage(tostring(err))end end;return a end
 label('搜索功法名称 / ID',12,15);local search=createEdit(f);search.Left=160;search.Top=10;search.Width=540;search.Text=''
 local view=createListView(f);view.Left=12;view.Top=48;view.Width=920;view.Height=300;view.ViewStyle='vsReport';view.ReadOnly=true;view.RowSelect=true;view.HideSelection=false
 for _,v in ipairs({{'ID',65},{'功法名称',230},{'装备状态',100},{'等级',70},{'理论经验',210},{'实战经验',210}})do local col=view.Columns.add();col.Caption=v[1];col.Width=v[2]end
 local detail=createMemo(f);detail.Left=12;detail.Top=360;detail.Width=920;detail.Height=150;detail.ReadOnly=true;detail.WordWrap=true;detail.ScrollBars='ssVertical'
 label('本次基础经验',12,530);local amount=createEdit(f);amount.Left=120;amount.Top=525;amount.Width=100;amount.Text='100'
 local status=label('刷新读取主角已拥有的武功。',12,640);status.Width=920;status.Height=62;status.WordWrap=true
 label('练到关口后，点击下方按钮直接选突破奖励。',12,566)
 local snapshot,visible,selected;local quiet=false
 local function draw()
  if not snapshot then return end;quiet=true;view.Items.clear();view.ItemIndex=-1;visible={};selected=nil;detail.Lines.Text=''
  for _,r in ipairs(snapshot.ordered or snapshot.rows)do if (r.name..' '..r.id):find(search.Text or '',1,true)then
   visible[#visible+1]=r;local row=view.Items.add();row.Caption=tostring(r.id);row.SubItems.add(r.name);row.SubItems.add(r.equipped and '● 已装备' or '未装备');row.SubItems.add(tostring(r.level));row.SubItems.add(string.format('%.2f',r.book));row.SubItems.add(string.format('%.2f',r.fight))
  end end;quiet=false
 end
 local function refresh()check(not E.busy,'操作执行中，请等待');snapshot=E.skillSnapshot();snapshot.ordered=E.orderSkills(snapshot);draw();status.Caption='已读取 '..#snapshot.rows..' 门武功。最近变动优先，满级置底；变动从本次打开开始记录，点击刷新更新。'end
 E.refreshSkills=refresh;search.OnChange=draw
 view.OnClick=function()if quiet then return end;selected=visible[view.ItemIndex+1];if selected then detail.Lines.Text=selected.name..'（ID '..selected.id..'）'..(selected.equipped and '　● 已装备' or '　未装备')..'\r\n'..selected.description end end
 view.OnSelectItem=function(_,_,yes)if yes then view.OnClick()end end
 btn('刷新功法',730,8,190,refresh)
 local function submit(kind)
  check(not E.autoSkill,'请先关闭连续修炼');check(selected,'请先选择一门功法')
  E.addSkillExperience(snapshot,selected,kind,tonumber(amount.Text),function(ok,msg)local success,err=pcall(refresh);status.Caption=msg;if not ok or not success then showMessage(msg..(success and '' or ('\n'..tostring(err))))end end)
  status.Caption='请求已提交；请回游戏运行一帧。完成前不要读档或重复点击。'
 end
 btn('增加理论经验',250,523,190,function()submit('book')end)
 btn('增加实战经验',460,523,190,function()submit('fight')end)
 btn('一键练到突破关口',670,523,250,function()
  check(not E.autoSkill,'请先关闭连续修炼');check(selected,'请先选择一门功法')
  E.trainSkillToObstacle(snapshot,selected,function(ok,msg)local yes,err=pcall(refresh);status.Caption=msg..(yes and '' or ('\n'..tostring(err)))end,function(msg)status.Caption=msg..' 请保持游戏运行。'end)
 end)
 btn('遗忘选中武功',475,560,240,function()
  check(not E.autoSkill,'请先关闭连续修炼');check(selected,'请先选择一门功法');check(not E.busy and not E.skillTraining,'已有请求执行中')
  local id=selected.id;local state=E.learningState();local r=check(state.byID[id],'武功已不存在，请刷新')
  check(state.context.hero==snapshot.context.hero and state.context.world==snapshot.context.world and r.ptr==selected.ptr,'选择已过期，请刷新')
  if messageDialog('遗忘「'..selected.name..'」ID '..id..'，当前 '..r.level..' 级'..(r.equipped and '【正在装备】' or '【未装备】')..'？\n失去该武功及等级加成；背包秘籍保留。',mtConfirmation,mbYes,mbNo)~=mrYes then return end
  status.Caption='正在提交遗忘，请保持游戏运行。'
  E.forgetCatalogSkill(id,function(ok,msg)local yes,err=pcall(refresh);status.Caption=msg..(yes and '' or ('\n'..tostring(err)));if not ok then showMessage(msg)end end,function(msg)status.Caption=msg end)
 end)
 btn('直接红色突破（不耗天数 / 药食）',12,600,365,function()
  check(not E.autoSkill,'请先关闭连续修炼')
  status.Caption='正在生成突破奖励，请保持游戏运行。'
  local ok,msg=pcall(E.directBreakthrough,snapshot,selected)
  status.Caption=tostring(msg);if not ok then error(msg)end
 end)
 local autoToggle=createCheckBox(f);autoToggle.Left=400;autoToggle.Top=604;autoToggle.Width=510;autoToggle.Caption='连续修炼＋随机突破（选中武功，直到10级）'
 local changingAuto=false
 E.autoSkillNotice=function(active,msg)changingAuto=true;autoToggle.Checked=active;changingAuto=false;status.Caption=msg end
 autoToggle.OnChange=function()
  if changingAuto then return end
  if not autoToggle.Checked then E.stopAutoSkill();return end
  local ok,err=pcall(E.startAutoSkill,snapshot,selected)
  if not ok then changingAuto=true;autoToggle.Checked=false;changingAuto=false;status.Caption=tostring(err);showMessage(tostring(err))end
 end
 btn('停止一键修炼',735,560,185,function()if E.autoSkill then E.stopAutoSkill();return end;if E.skillTraining then E.skillTraining.cancel=true;status.Caption='将在当前已提交请求完成后停止。'else status.Caption='当前没有一键修炼请求。'end end)
 f.show();local ok,err=pcall(refresh);if not ok then status.Caption=tostring(err)end
end



-- Sect roster uses ForceData.ownHeros IDs, never world-list positions as hero IDs.
E.discipleStatGroups={
 {name='基础属性',labels={'力道','灵巧','智力','意志','体质','经脉'},offsets={0x138,0x128,0x130}},
 {name='武学',labels={'内功','轻功','绝技','拳掌','剑法','刀法','长兵','奇门','射术'},offsets={0x150,0x140,0x148}},
 {name='技艺',labels={'医术','毒术','学识','口才','采伐','木植','锻造','炼药','烹饪'},offsets={0x168,0x158,0x160}}
}
local discipleRanks={'外门弟子','入门弟子','正式弟子','亲传弟子','长老','副掌门','掌门'}
local function discipleValues(hero,offset,count)
 local ls=q(hero+offset);check(int(ls+0x18)==count,'弟子属性数组长度不符')
 local a=q(ls+0x10);check(cname(a)=='Single[]','弟子属性数组类型不符')
 local out={};for n=0,count-1 do out[n+1]=flt(a+0x20+n*4)end;return out
end
function E.discipleSnapshot()
 local c=context();local fid=int(c.hero+0x84);check(fid&gt;=0,'主角尚未加入门派')
 local forces=q(c.world+0x48);local fa=q(forces+0x10);local fc=int(forces+0x18);local fv=int(forces+0x1C)
 check(fc&gt;=0 and fc&lt;10000,'门派列表异常');local force
 for n=0,fc-1 do local p=readQword(fa+0x20+n*8);if p and p~=0 and int(p+0x10)==fid then force=p;break end end
 check(force and cname(force)=='ForceData','未找到当前门派')
 local members=q(force+0x70);local ma=q(members+0x10);local mc=int(members+0x18);local mv=int(members+0x1C)
 check(mc&gt;=0 and mc&lt;10000 and cname(ma)=='Int32[]','门派名册异常')
 local wanted={};for n=0,mc-1 do local id=int(ma+0x20+n*4);check(not wanted[id],'门派名册ID重复');wanted[id]=true end
 local heroes=q(c.world+0x50);local ha=q(heroes+0x10);local hc=int(heroes+0x18);local hv=int(heroes+0x1C)
 check(hc&gt;=0 and hc&lt;100000,'角色列表异常');local rows={};local found={}
 for n=0,hc-1 do local p=readQword(ha+0x20+n*8)
  if p and p~=0 then local id=int(p+0x58)
   if wanted[id] and int(p+0x84)==fid then
    check(cname(p)=='HeroData' and not found[id],'门派角色类型或ID异常');found[id]=true
    local r={ptr=p,id=id,index=n,name=str(readQword(p+0x68)),rank=int(p+0xB8),age=int(p+0xD4),female=readBytes(p+0x80,1)==1,dead=readBytes(p+0x61,1)==1,
     favor=id~=0 and flt(p+0x124) or nil,loyal=flt(p+0x1CC),score=flt(p+0x388),hp=flt(p+0x178),maxhp=flt(p+0x180),mana=flt(p+0x190),maxmana=flt(p+0x198),power=flt(p+0x184),maxpower=flt(p+0x18C),contribution=flt(p+0x1C0),month=flt(p+0xA0),salary=int(p+0x1F0),stats={}}
    if readBytes(p+0xB4,1)==1 then r.rank=6 end
    r.role=discipleRanks[r.rank+1] or ('身份 '..r.rank);r.sex=r.female and '女' or '男';r.state=r.dead and '已故' or '在世'
    for g,spec in ipairs(E.discipleStatGroups)do r.stats[g]={};for mode,off in ipairs(spec.offsets)do r.stats[g][mode]=discipleValues(p,off,#spec.labels)end end
    rows[#rows+1]=r
   end
  end
 end
 local now=context()
 check(now.pid==c.pid and now.world==c.world and now.hero==c.hero and int(now.hero+0x84)==fid,'已切换存档或门派，请刷新')
 for _,v in ipairs({{forces,fa,fc,fv},{members,ma,mc,mv},{heroes,ha,hc,hv}})do check(q(v[1]+0x10)==v[2] and int(v[1]+0x18)==v[3] and int(v[1]+0x1C)==v[4],'读取期间名册变化，请刷新')end
 local name=str(readQword(force+0x198));if name=='' then name=str(readQword(force+0x18))end
 return {context=c,force=force,id=fid,name=name,rows=rows,count=mc,missing=mc-#rows}
end
function E.discipleColumns(group,mode)
 local cols={{'id','ID',65},{'name','姓名',135},{'role','身份',105},{'age','年龄',60}}
 if group==0 then
  for _,col in ipairs({{'favor','好感',80},{'loyal','忠诚',80},{'score','战力',90},{'hp','生命',85},{'mana','内力',85},{'power','体力',75},{'contribution','功绩',85},{'month','本月贡献',95},{'salary','薪俸',75}})do cols[#cols+1]=col end
 else for n,label in ipairs(E.discipleStatGroups[group].labels)do cols[#cols+1]={'stat'..n,label,95,n}end end
 return cols
end
function E.discipleValue(r,key,group,mode)
 local n=key:match('^stat(%d+)$');if n then return r.stats[group][mode][tonumber(n)]end
 if key=='role' then return r.rank end
 return r[key]
end
function E.filterDisciples(rows,opt)
 local out={};local term=(opt.search or ''):lower()
 for _,r in ipairs(rows)do
  if (not opt.rank or r.rank==opt.rank) and (r.name..' '..r.id..' '..r.role..' '..r.sex..' '..r.state):lower():find(term,1,true)then out[#out+1]=r end
 end
 table.sort(out,function(a,b)
  local x,y=E.discipleValue(a,opt.key,opt.group,opt.mode),E.discipleValue(b,opt.key,opt.group,opt.mode)
  if x==y then return a.id&lt;b.id end;if x==nil then return false end;if y==nil then return true end
  if opt.asc then return x&lt;y else return x&gt;y end
 end)
 return out
end
function E.describeDisciple(r)
 local function num(x)return x and string.format('%.1f',x) or '—'end
 local lines={r.name..(r.id==0 and '（主角）' or '')..' · '..r.sex..' · '..r.age..'岁 · '..r.role..' · '..r.state,
  '好感 '..num(r.favor)..'　忠诚 '..num(r.loyal)..'　战力 '..num(r.score),
  '生命 '..num(r.hp)..' / '..num(r.maxhp)..'　内力 '..num(r.mana)..' / '..num(r.maxmana)..'　体力 '..num(r.power)..' / '..num(r.maxpower),
  '功绩 '..num(r.contribution)..'　本月贡献 '..num(r.month)..'　薪俸 '..r.salary,'','各项：基础值 / 上限 / 当前汇总'}
 for g,spec in ipairs(E.discipleStatGroups)do
  local values={};for n,label in ipairs(spec.labels)do values[#values+1]=label..' '..num(r.stats[g][2][n])..' / '..num(r.stats[g][3][n])..' / '..num(r.stats[g][1][n])end
  lines[#lines+1]=spec.name..'：'..table.concat(values,'； ')
 end
 return table.concat(lines,'\r\n')
end
E.discipleEditSpecs={
 favor={label='好感',offset=0x124,min=-100,max=100},loyal={label='忠诚',offset=0x1CC,min=0,max=100},
 age={label='年龄',offset=0xD4,min=1,max=200,integer=true},
 hp={label='生命',offset=0x178,min=0,maxKey='maxhp'},mana={label='内力',offset=0x190,min=0,maxKey='maxmana'},power={label='体力',offset=0x184,min=0,maxKey='maxpower'},
 contribution={label='功绩',offset=0x1C0,min=0,max=10000000},month={label='本月贡献',offset=0xA0,min=0,max=10000000}
}
function E.discipleEditSpec(r,key,group,mode)
 local n=tonumber(key:match('^stat(%d+)$'))
 if n then
  check(group&gt;=1 and group&lt;=3 and (mode==2 or mode==3),'当前汇总由游戏计算，请切换到基础值或属性上限修改')
  local g=E.discipleStatGroups[group];check(n&gt;=1 and n&lt;=#g.labels,'属性列无效')
  return {label=g.labels[n]..(mode==2 and ' · 基础值' or ' · 上限'),listOffset=g.offsets[mode],index=n,count=#g.labels,min=0,max=10000}
 end
 local spec=check(E.discipleEditSpecs[key],'该列由游戏计算或涉及身份关联，不能直接写入')
 check(key~='favor' or r.id~=0,'主角没有对自己的好感值')
 return spec
end
local function discipleEditAddress(r,spec)
 if not spec.listOffset then return r.ptr+spec.offset end
 local ls=q(r.ptr+spec.listOffset);check(int(ls+0x18)==spec.count,'属性数组已变化，请刷新')
 local a=q(ls+0x10);check(cname(a)=='Single[]','属性数组类型错误')
 return a+0x20+(spec.index-1)*4
end
function E.editDisciple(previous,selected,key,group,mode,value,undoing,excludeLeader)
 check(not E.busy,'已有操作执行中，请等待')
 local spec=E.discipleEditSpec(selected,key,group,mode)
 local fresh=E.discipleSnapshot();local a,b=previous.context,fresh.context
 check(a.pid==b.pid and a.world==b.world and a.hero==b.hero and previous.force==fresh.force and previous.id==fresh.id,'已读档或切换门派，请刷新并重新选择')
 local r;for _,row in ipairs(fresh.rows)do if row.id==selected.id and row.ptr==selected.ptr then r=row;break end end
 check(r and not r.dead,'选中弟子已离开门派、失效或死亡，请刷新')
 check(not excludeLeader or r.rank~=6,'该角色已成为掌门，已停止批量修改')
 local old=E.discipleValue(selected,key,group,mode);local current=E.discipleValue(r,key,group,mode)
 check(equal(old,current),'该数值已被游戏改变，请刷新后再修改')
 local v=tonumber(value);local limit=spec.maxKey and r[spec.maxKey] or spec.max
 check(v and v==v and v&gt;=spec.min and v&lt;=limit and (not spec.integer or v%1==0),'数值无效；范围 '..spec.min..'～'..limit..(spec.integer and '，需整数' or ''))
 if equal(v,current)then return '数值未变化。'end
 local address=discipleEditAddress(r,spec);local reader=spec.integer and int or flt;local writer=spec.integer and writeInteger or writeFloat
 check(equal(reader(address),current),'写入前数值已变化，请刷新')
 check(writer(address,v),'写入失败')
 local actual=reader(address)
 E.discipleUndo={snapshot=fresh,row=r,key=key,group=group,mode=mode,before=current,after=actual}
 check(equal(actual,v),'写后读回不一致，请刷新核对')
 -- Signal existing game refresh paths instead of editing derived totals.
 check(writeBytes(r.ptr+0x2D8,1),'数值已写入，但角色刷新标记写入失败，请刷新游戏人物页')
 check(writeBytes(fresh.force+0x10C,1) and writeBytes(fresh.force+0x10D,1),'数值已写入，但门派刷新标记写入失败')
 if undoing then E.discipleUndo=nil end
 return r.name..' · '..spec.label..'：'..string.format('%g → %g',current,actual)..'。汇总数值由游戏重新计算。'
end
function E.undoDiscipleEdit()
 local u=check(E.discipleUndo,'没有可撤销的弟子修改')
 if u.batch then
  local restored=0
  for n=#u.batch,1,-1 do
   E.discipleUndo=u.batch[n];local ok,msg=pcall(E.undoDiscipleEdit)
   if not ok then E.discipleUndo=u;error('已撤销 '..restored..' 人；其余未撤销：'..tostring(msg))end
   table.remove(u.batch,n);restored=restored+1
  end
  E.discipleUndo=nil;return '已撤销本次批量修改，共 '..restored..' 项。'
 end
 local selected={};for k,v in pairs(u.row)do selected[k]=v end
 if u.key:match('^stat')then
  selected.stats={};for g,modes in ipairs(u.row.stats)do selected.stats[g]={};for m,values in ipairs(modes)do local copy={};for n,v in ipairs(values)do copy[n]=v end;selected.stats[g][m]=copy end end
  selected.stats[u.group][u.mode][tonumber(u.key:match('%d+'))]=u.after
 else selected[u.key]=u.after end
 return E.editDisciple(u.snapshot,selected,u.key,u.group,u.mode,u.before,true)
end
function E.raiseDiscipleLoyalty()
 check(not E.busy,'已有操作执行中，请等待')
 local s=E.discipleSnapshot();local changes={};local skipped=0;local previousUndo=E.discipleUndo
 for _,r in ipairs(s.rows)do
  if not r.dead and r.rank~=6 and r.loyal&lt;99 then
   local ok,msg=pcall(E.editDisciple,s,r,'loyal',0,1,99,false,true)
   local latest=E.discipleUndo
   if latest~=previousUndo and latest and not latest.batch and latest.row.id==r.id and latest.key=='loyal' then changes[#changes+1]=latest end
   if not ok then E.discipleUndo=#changes&gt;0 and {batch=changes} or previousUndo;error('已修改 '..#changes..' 人，操作已停止：'..tostring(msg))end
  else skipped=skipped+1 end
 end
 E.discipleUndo=#changes&gt;0 and {batch=changes} or previousUndo
 return '已将 '..#changes..' 名弟子忠诚提高到99；跳过掌门、已故及忠诚已达99的 '..skipped..' 人。可撤销本次批量修改。'
end
function E.saveDiscipleAll(previous,selected,inputs)
 check(not E.busy,'已有操作执行中')
 local fresh=E.discipleSnapshot()
 check(same(previous.context,fresh.context) and previous.force==fresh.force and previous.id==fresh.id,'已读档或切换门派，请重新打开编辑窗口')
 local r;for _,row in ipairs(fresh.rows)do if row.id==selected.id and row.ptr==selected.ptr then r=row;break end end
 check(r and not r.dead,'该弟子已离开、失效或死亡')
 local changes={};local seen={}
 -- Validate every requested field before the first write.
 for _,input in ipairs(inputs)do
  local key,g,m=input.key,input.group,input.mode;local token=key..':'..g..':'..m
  check(not seen[token],'重复属性');seen[token]=true
  local spec=E.discipleEditSpec(r,key,g,m);local v=tonumber(input.value)
  local limit=spec.maxKey and r[spec.maxKey] or spec.max
  check(v and v==v and v&gt;=spec.min and v&lt;=limit and (not spec.integer or v%1==0),spec.label..'：请输入 '..spec.min..'～'..limit..(spec.integer and ' 的整数' or ' 的数值'))
  local before=E.discipleValue(selected,key,g,m);local now=E.discipleValue(r,key,g,m)
  check(equal(before,now),spec.label..' 已变化，请重新读取后修改')
  if not equal(v,now)then changes[#changes+1]={key=key,group=g,mode=m,value=v}end
 end
 if #changes==0 then return '没有修改任何数值。'end
 table.sort(changes,function(a,b)
  local x=a.group&gt;0 and (a.mode==3 and 0 or 1) or 2
  local y=b.group&gt;0 and (b.mode==3 and 0 or 1) or 2
  if x~=y then return x&lt;y end;if a.group~=b.group then return a.group&lt;b.group end;return a.key&lt;b.key
 end)
 local history={};local prior=E.discipleUndo
 for _,v in ipairs(changes)do
  local last=E.discipleUndo
  local ok,msg=pcall(E.editDisciple,fresh,r,v.key,v.group,v.mode,v.value)
  if E.discipleUndo~=last and E.discipleUndo then history[#history+1]=E.discipleUndo end
  if not ok then E.discipleUndo=#history&gt;0 and {batch=history} or prior;error('已保存 '..#history..' 项后停止：'..tostring(msg)..'。已完成项目可撤销。')end
 end
 E.discipleUndo={batch=history}
 return r.name..'：已保存 '..#history..' 项修改，可撤销本次保存。'
end
function E.showDiscipleAll(previous,selected)
 check(selected and not selected.dead,'请选择一名在世弟子')
 local f=createForm(false);E.discipleAllForms=E.discipleAllForms or {};E.discipleAllForms[#E.discipleAllForms+1]=f
 f.Caption='弟子全部属性 · '..selected.name..'（ID '..selected.id..'）';f.Width=1120;f.Height=745;f.Position='poScreenCenter';f.OnClose=function()return caHide or 1 end
 local function label(s,x,y,w)local p=createLabel(f);p.Caption=s;p.Left=x;p.Top=y;if w then p.Width=w end;return p end
 local header=label('',16,12,1080)
 label('基础值、属性上限可编辑；当前汇总由装备、天赋、门派等加成计算，仅作对照。',16,40,1080)
 local controls={};local snap,row=previous,selected
 local function edit(key,g,m,x,y,w)
  local p=createEdit(f);p.Left=x;p.Top=y;p.Width=w
  controls[#controls+1]={key=key,group=g,mode=m,edit=p};return p
 end
 local totals={}
 for g,spec in ipairs(E.discipleStatGroups)do
  local x=16+(g-1)*363;label(spec.name,x,76,330)
  label('属性',x,105);label('基础值',x+83,105);label('上限',x+166,105);label('当前汇总',x+253,105)
  for n,name in ipairs(spec.labels)do
   local y=133+(n-1)*30;label(name,x,y+4,80)
   edit('stat'..n,g,2,x+80,y,77);edit('stat'..n,g,3,x+163,y,77)
   totals[#totals+1]={group=g,index=n,label=label('',x+253,y+4,92)}
  end
 end
 label('人物与资源',16,422)
 local overview={{'age','年龄'},{'favor','好感'},{'loyal','忠诚'},{'contribution','功绩'},{'hp','当前生命'},{'mana','当前内力'},{'power','当前体力'},{'month','本月贡献'}}
 for n,spec in ipairs(overview)do
  local x=16+((n-1)%4)*272;local y=453+math.floor((n-1)/4)*40
  label(spec[2],x,y+4,92);edit(spec[1],0,1,x+95,y,155)
 end
 local note=label('',16,538,1080);note.WordWrap=true;note.Height=48
 local status=label('',16,636,1080);status.WordWrap=true;status.Height=60
 local function populate()
  header.Caption=row.name..' · ID '..row.id..' · '..row.role..' · '..snap.name..'（仅修改此人）'
  for _,v in ipairs(controls)do
   local enabled=not (v.key=='favor' and row.id==0)
   v.edit.Enabled=enabled
   v.edit.Text=enabled and string.format('%.9g',E.discipleValue(row,v.key,v.group,v.mode)) or '不适用'
   v.original=v.edit.Text
  end
  for _,v in ipairs(totals)do v.label.Caption=string.format('%.6g',row.stats[v.group][1][v.index])end
  note.Caption=string.format('当前上限：生命 %.6g、内力 %.6g、体力 %.6g。战力、身份和最终汇总不在这里直接写入。\n只保存改动过的输入框；基础值/上限与原单项编辑使用相同规则。',row.maxhp,row.maxmana,row.maxpower)
 end
 local function reload()
  local fresh=E.discipleSnapshot();check(same(snap.context,fresh.context) and snap.force==fresh.force,'已切换存档或门派，请关闭后重新选择弟子')
  local found;for _,r in ipairs(fresh.rows)do if r.id==row.id and r.ptr==row.ptr then found=r;break end end
  check(found and not found.dead,'弟子已离开门派或失效');snap=fresh;row=found;populate()
 end
 local function button(text,x,w,fn)
  local p=createButton(f);p.Caption=text;p.Left=x;p.Top=590;p.Width=w
  p.OnClick=function()local ok,msg=pcall(fn);status.Caption=tostring(msg);if not ok then showMessage(tostring(msg))end end
 end
 button('保存全部改动',16,230,function()
  local changes={};for _,v in ipairs(controls)do if v.edit.Enabled and v.edit.Text~=v.original then changes[#changes+1]={key=v.key,group=v.group,mode=v.mode,value=v.edit.Text}end end
  local msg=E.saveDiscipleAll(snap,row,changes);reload();if E.refreshDisciples then E.refreshDisciples()end;return msg
 end)
 button('撤销本次保存',268,230,function()
  local u=check(E.discipleUndo,'没有可撤销记录');local records=u.batch or {u}
  for _,v in ipairs(records)do check(v.row.id==row.id and v.row.ptr==row.ptr,'最近一次修改属于其他弟子，请在列表中撤销')end
  local msg=E.undoDiscipleEdit();reload();if E.refreshDisciples then E.refreshDisciples()end;return msg
 end)
 button('重新读取（放弃未保存输入）',520,300,function()reload();return '已重新读取当前弟子数据。'end)
 populate();status.Caption='可以同时修改多个输入框，再点“保存全部改动”。';f.show()
end

function E.showDisciples()
 if E.discipleForm then E.discipleForm.show();E.discipleForm.bringToFront();E.refreshDisciples();return end
 local f=createForm(false);E.discipleForm=f;f.Caption='门派弟子 · 属性查看 / 修改';f.Width=1260;f.Height=830;f.Position='poScreenCenter';f.OnClose=function()return caHide or 1 end
 local function label(text,x,y)local a=createLabel(f);a.Caption=text;a.Left=x;a.Top=y;return a end
 local function combo(x,width,values)local a=createComboBox(f);a.Left=x;a.Top=42;a.Width=width;a.Style='csDropDownList';for _,v in ipairs(values)do a.Items.add(v)end;a.ItemIndex=0;return a end
 label('搜索姓名 / ID',12,16);local search=createEdit(f);search.Left=120;search.Top=10;search.Width=550;search.Text=''
 local refreshButton=createButton(f);refreshButton.Left=690;refreshButton.Top=9;refreshButton.Width=140;refreshButton.Caption='刷新弟子列表'
 label('身份',12,47);local ranks={'全部身份'};for _,v in ipairs(discipleRanks)do ranks[#ranks+1]=v end;local rank=combo(55,180,ranks)
 local group=combo(255,180,{'概览','基础属性','武学','技艺'});local mode=combo(455,210,{'当前汇总（含加成）','基础值','属性上限'})
 label('选中弟子后点“全部属性”，或在下方修改单项。',690,47)
 local view=createListView(f);view.Left=12;view.Top=80;view.Width=1220;view.Height=410;view.ViewStyle='vsReport';view.ReadOnly=true;view.RowSelect=true;view.HideSelection=false
 local detail=createMemo(f);detail.Left=12;detail.Top=502;detail.Width=1220;detail.Height=150;detail.ReadOnly=true;detail.WordWrap=true;detail.ScrollBars='ssVertical'
 local editTarget=label('请选择弟子',12,665);editTarget.Width=1200
 local field=combo(12,260,{});field.Top=690
 local value=createEdit(f);value.Left=285;value.Top=690;value.Width=180;value.Text=''
 local save=createButton(f);save.Left=485;save.Top=688;save.Width=150;save.Caption='写入选中数值'
 local undo=createButton(f);undo.Left=650;undo.Top=688;undo.Width=170;undo.Caption='撤销上次修改'
 local loyalty=createButton(f);loyalty.Left=840;loyalty.Top=688;loyalty.Width=290;loyalty.Caption='除掌门外：忠诚至少99'
 local status=label('读取当前门派名册。',12,740);status.Width=1220;status.Height=50;status.WordWrap=true
 local snap,visible,columns,selectedID,editSelection;local fieldKeys={};local updateEditor;local key='score';local asc=false;local quiet=false
 local function draw()
  if not snap then return end
  quiet=true;view.Items.clear();view.ItemIndex=-1
  visible=E.filterDisciples(snap.rows,{search=search.Text,rank=rank.ItemIndex&gt;0 and rank.ItemIndex-1 or nil,key=key,asc=asc,group=group.ItemIndex,mode=mode.ItemIndex+1})
  local selected
  for n,r in ipairs(visible)do local row=view.Items.add();row.Caption=tostring(r.id)
   for j=2,#columns do local k=columns[j][1];local v=k=='role' and r.role or E.discipleValue(r,k,group.ItemIndex,mode.ItemIndex+1)
    local text=type(v)=='number' and string.format('%g',math.floor(v*10+0.5)/10) or tostring(v or '—')
    if k=='name' then text=text..(r.id==0 and '（主角）' or '')..(r.dead and '（已故）' or '')end
    row.SubItems.add(text)
   end
   if r.id==selectedID then view.ItemIndex=n-1;selected=r end
  end
  detail.Lines.Text=selected and E.describeDisciple(selected) or '选择一名弟子，查看全部属性及基础值 / 上限 / 当前汇总对照。'
  status.Caption=snap.name..'：名册 '..snap.count..' 人，读取 '..#snap.rows..' 人，筛选显示 '..#visible..' 人。'..(snap.missing&gt;0 and ('有 '..snap.missing..' 人未能匹配当前角色数据。') or '')..' 当前汇总取游戏缓存；游戏内数值变化后点击刷新。'
  quiet=false;if updateEditor then updateEditor()end
 end
 local function columnsChanged()
  quiet=true;view.Items.clear();view.Columns.clear();columns=E.discipleColumns(group.ItemIndex,mode.ItemIndex+1)
  for _,v in ipairs(columns)do local col=view.Columns.add();col.Caption=v[2];col.Width=v[3]end
  key=group.ItemIndex==0 and 'score' or 'stat1';asc=false;mode.Enabled=group.ItemIndex~=0;quiet=false;draw()
 end
 local function refresh()local ok,result=pcall(E.discipleSnapshot);if ok then snap=result;draw()else snap=nil;visible={};view.Items.clear();detail.Lines.Text='';status.Caption=tostring(result);if updateEditor then updateEditor()end end end
 local allButton=createButton(f);allButton.Left=850;allButton.Top=9;allButton.Width=260;allButton.Caption='编辑选中弟子 · 全部属性'
 allButton.OnClick=function()local ok,err=pcall(function()check(snap,'请先刷新弟子列表');E.showDiscipleAll(snap,visible and visible[view.ItemIndex+1])end);if not ok then status.Caption=tostring(err)end end
 E.refreshDisciples=refresh;refreshButton.OnClick=refresh
 search.OnChange=draw;rank.OnChange=draw;group.OnChange=columnsChanged;mode.OnChange=draw
 view.OnColumnClick=function(_,col)local spec=columns[col.Index+1];if not spec then return end;if key==spec[1]then asc=not asc else key=spec[1];asc=key=='name'end;draw()end
 updateEditor=function()
  local r=visible and visible[view.ItemIndex+1];local previousKey=fieldKeys[field.ItemIndex+1]
  field.OnChange=nil;field.Items.clear();fieldKeys={};editSelection=nil;value.Text='';save.Enabled=false;value.Enabled=false
  if r and snap then
   for _,col in ipairs(columns)do local ok,spec=pcall(E.discipleEditSpec,r,col[1],group.ItemIndex,mode.ItemIndex+1)
    if ok then fieldKeys[#fieldKeys+1]=col[1];field.Items.add(spec.label)end
   end
   field.ItemIndex=0;for n,k in ipairs(fieldKeys)do if k==previousKey then field.ItemIndex=n-1 end end
   editTarget.Caption='修改对象：'..r.name..'（ID '..r.id..'） · '..r.role..(group.ItemIndex&gt;0 and mode.ItemIndex==0 and '；汇总只读，请切换基础值或属性上限。' or '')
  else editTarget.Caption='请选择弟子' end
  field.Enabled=#fieldKeys&gt;0
  local function chooseField()
   local k=fieldKeys[field.ItemIndex+1];editSelection=nil;save.Enabled=false;value.Enabled=false
   if r and k and not r.dead then
    editSelection={snapshot=snap,row=r,key=k,group=group.ItemIndex,mode=mode.ItemIndex+1}
    value.Text=string.format('%.9g',E.discipleValue(r,k,group.ItemIndex,mode.ItemIndex+1));save.Enabled=true;value.Enabled=true
   end
  end
  field.OnChange=chooseField;chooseField()
 end
 save.OnClick=function()
  local ok,msg=pcall(function()local e=check(editSelection,'请选择可修改的属性');return E.editDisciple(e.snapshot,e.row,e.key,e.group,e.mode,value.Text)end)
  if ok then refresh()end;status.Caption=tostring(msg)
 end
 undo.OnClick=function()local ok,msg=pcall(E.undoDiscipleEdit);if ok then refresh()end;status.Caption=tostring(msg)end
 loyalty.OnClick=function()local ok,msg=pcall(E.raiseDiscipleLoyalty);refresh();status.Caption=tostring(msg)end
 view.OnClick=function()if quiet then return end;local r=visible and visible[view.ItemIndex+1];selectedID=r and r.id;if r then detail.Lines.Text=E.describeDisciple(r)end;updateEditor()end
 view.OnDblClick=function()if value.Enabled then value.setFocus();value.selectAll()end end
 view.OnSelectItem=function(_,_,yes)if yes then view.OnClick()end end
 columnsChanged();f.show();refresh()
end

-- Manual recovery; no automatic retry or forced battle result.
function E.battleRecoverySnapshot()
 local c=context();local base=getAddressSafe('GameAssembly.dll')
 local slot=q(q(base+0x1E90420)+0xB8)+0x50;local battle=q(slot)
 check(q(battle+0x10)~=0 and readBytes(battle+0x1A4,1)==1,'当前没有有效战斗')
 local unit=q(battle+0x110)
 check(q(unit+0x10)~=0 and readBytes(unit+0xD5,1)==0,'当前战斗角色已经失效')
 return {context=c,battle=battle,slot=slot,unit=unit,state=int(battle+0x124),playing=readBytes(battle+0x128,1)==1,paused=readBytes(battle+0x1D0,1)==1}
end
function E.canRecoverBattle(s)
 return s.state==11 and s.playing and not s.paused
end
function E.recoverBattle(onDone)
 check(not E.busy,'已有请求执行中，请等待')
 local s=E.battleRecoverySnapshot();check(E.canRecoverBattle(s),'仅适用于攻击动画卡住；当前不符合条件，未修改')
 local now=getTickCount();check(not E.lastBattleRecovery or now-E.lastBattleRecovery&gt;=15000,'刚触发过修复，请至少等待15秒并检查游戏')
 local c=s.context;E.busy=true
 local t=createTimer(nil);t.Enabled=false;t.Interval=250;E.copyTimer=t
 local began=now;local submitted=false;local d;local settled
 local function finish(ok,msg)t.destroy();E.copyTimer=nil;E.busy=false;onDone(ok,msg)end
 t.OnTimer=function()
  local ok,err=pcall(function()
   if not submitted then
    local fresh=E.battleRecoverySnapshot()
    check(fresh.context.pid==c.pid and fresh.context.world==c.world and fresh.context.hero==c.hero and fresh.battle==s.battle and fresh.unit==s.unit and E.canRecoverBattle(fresh),'战斗状态已变化，已取消修复')
    if getTickCount()-began&lt;5000 then return end
    local _,items=E.snapshot();check(#items&gt;0,'背包为空，无法校验桥接')
    local b=bridge(fresh.context,items[1]);d=b.data;check(int(d)~=1 and int(d)~=2,'桥接已有请求')
    local base=getAddressSafe('GameAssembly.dll')
    local ending=method(q(s.battle),'BattleUnitAttackEnd',1,0x5351B0,base)
    local klass=q(s.battle);local start
    while klass and klass~=0 do local yes,m=pcall(method,klass,'StartCoroutine',1,0xAE80B0,base);if yes then start=m;break end;klass=readQword(klass+0x58)end
    check(start,'没有找到协程启动接口')
    c=fresh.context
    for off,v in pairs({[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x50]=ending,[0x68]=0,[0xC8]=d+0x200,[0x200]=d+0x240,[0x350]=s.battle,[0x358]=s.slot,[0x360]=s.unit,[0x380]=start})do check(writeQword(d+off,v),'修复参数写入失败')end
    for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=7})do check(writeInteger(d+off,v),'修复参数写入失败')end
    check(writeFloat(d+0x240,0),'等待参数写入失败')
    E.lastBattleRecovery=getTickCount();check(writeInteger(d,1),'提交修复失败');submitted=true
    return
   end
   check(getOpenedProcessID()==c.pid,'游戏进程已变化')
   local state=int(d);if state==1 or state==2 then return end
   check(state==3,({[4]='战斗已变化，修复未执行。',[5]='原生接口报错，请检查游戏，勿连续重试。'})[state] or '修复请求未成功')
   settled=settled or getTickCount();if getTickCount()-settled&lt;2000 then return end
   local readable,after=pcall(E.battleRecoverySnapshot)
   local progressed=readable and (after.battle~=s.battle or after.unit~=s.unit or after.state~=11 or not after.playing)
   finish(true,progressed and '已补触发一次攻击收尾，检测到战斗状态已推进。' or '已补触发一次攻击收尾；请回游戏确认，未自动重复执行。')
  end)
  if not ok then finish(false,tostring(err))end
 end
 t.Enabled=true
end
function E.showBattleRecovery()
 if E.recoveryForm then E.recoveryForm.show();E.recoveryForm.bringToFront();return end
 local f=createForm(false);E.recoveryForm=f;f.Caption='战斗修复 · 攻击动画卡住';f.Width=590;f.Height=235;f.Position='poScreenCenter';f.OnClose=function()return caHide or 1 end
 local note=createLabel(f);note.Left=16;note.Top=16;note.Width=550;note.Height=60;note.WordWrap=true
 note.Caption='仅用于攻击动作一直不结束。点击后观察5秒，状态未变化才补触发一次原生收尾。请保持游戏运行，勿暂停或读档。'
 local status=createLabel(f);status.Left=16;status.Top=130;status.Width=550;status.Height=65;status.WordWrap=true;status.Caption='不会强制胜利或重新播放攻击。'
 local button=createButton(f);button.Left=16;button.Top=83;button.Width=260;button.Caption='修复攻击卡住（单次）'
 button.OnClick=function()
  local ok,err=pcall(function()
   E.recoverBattle(function(success,msg)status.Caption=msg;button.Enabled=true end)
   button.Enabled=false;status.Caption='正在观察战斗状态；请回到游戏等待处理。'
  end)
  if not ok then status.Caption=tostring(err);button.Enabled=true end
 end
 f.show()
end

-- Persistent cosmetic-only hooks. No HeroData skin/stat field writes.
local function cosmeticBattle()
 local c=context();local base=getAddressSafe('GameAssembly.dll')
 local k=readQword(base+0x1E90420);if not k or k==0 then return end
 local st=readQword(k+0xB8);if not st or st==0 then return end
 local battle=readQword(st+0x50);if not battle or battle==0 then return end
 local unit=readQword(battle+0x1B0);if not unit or unit==0 or readQword(unit+0x40)~=c.hero then return end
 local sa=readQword(unit+0x18);if not sa or sa==0 or not readQword(sa+0x10) or readQword(sa+0x10)==0 then return end
 local sk=readQword(sa+0xC0);if not sk or sk==0 then return end
 local skin=readQword(sk+0x58);local name=skin and skin~=0 and str(readQword(skin+0x10)) or ''
 return {context=c,battle=battle,slot=st+0x50,unit=unit,sa=sa,name=name,active=readQword(battle+0x110) or 0}
end
function E.refreshBattleOutfit(b,onDone)
 check(readBytes(b.battle+0x128,1)~=1,'战斗正在播放动作，稍后再刷新外观')
 check(not E.busy,'已有请求执行中')
 local c=b.context;local _,items=E.snapshot();check(#items&gt;0,'背包为空，暂不能校验原生桥')
 local bridgeData=bridge(c,items[1]);local d=bridgeData.data;local base=getAddressSafe('GameAssembly.dll')
 check(int(d)~=1 and int(d)~=2,'桥接请求未完成')
 local fn=method(q(c.hero),'RefreshHeroSkeleton',1,0x5D8070,base)
 local hud=method(q(b.battle),'SetNowActiveUnitUI',0,0x556D40,base)
 for off,v in pairs({[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x50]=fn,[0x68]=0,[0xC8]=d+0x200,[0x200]=b.sa,[0x350]=b.battle,[0x358]=b.slot,[0x360]=b.unit,[0x368]=b.sa,[0x380]=hud})do check(writeQword(d+off,v),'战斗预览参数写入失败')end
 for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=6})do check(writeInteger(d+off,v),'战斗参数写入失败')end
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100;E.busy=true;E.copyTimer=timer
 timer.OnTimer=function()
  local state=getOpenedProcessID()==c.pid and readInteger(d) or -1;if state==1 or state==2 then return end
  timer.destroy();E.copyTimer=nil;E.busy=false
  local now;local ok,err=pcall(function()check(state==3,'战斗模型已变化或接口异常，请检查当前战斗');now=cosmeticBattle();check(now and now.unit==b.unit,'战斗已结束或主角单位变化')end)
  onDone(ok,ok and now.name or tostring(err))
 end
 if not writeInteger(d,1)then timer.destroy();E.copyTimer=nil;E.busy=false;error('战斗请求提交失败')end;timer.Enabled=true
end
local function addCosmeticNameHook(b)
 if #b.patches&gt;=4 then return end
 check(#b.patches==3,'旧版外观钩子结构异常')
 local a=b.base+0x5CCA40;local original={0x48,0x89,0x5C,0x24,0x08,0x48,0x89,0x6C,0x24,0x20}
 check(bytesEqual(a,original),'对话外观名称入口被其他脚本改变')
 local entry=b.mem+0x600
 local code=string.format('label(skip)\n%X:\npushfq\npush rax\nmov rax,%X\ncmp dword ptr [rax],1\njne skip\ncmp dword ptr [rcx+58],0\njne skip\ncmp byte ptr [rcx+10],0\njne skip\nmov r8d,[rax+4]\nmov r9d,[rax+8]\nskip:\npop rax\npopfq\ndb 48 89 5C 24 08 48 89 6C 24 20\njmp %X',entry,b.data,a+10)
 assemble(code)
 assemble(string.format('assert(%X,48 89 5C 24 08 48 89 6C 24 20)\n%X:\njmp %X\nnop\nnop\nnop\nnop\nnop',a,a,entry))
 b.patches[#b.patches+1]={address=a,original=original,patch=readBytes(a,10,true)}
end
local function installCosmetic()
 local base=getAddressSafe('GameAssembly.dll');local pid=getOpenedProcessID();local old=LongYiCosmeticV1
 if old and old.pid==pid and old.base==base then
  for _,v in ipairs(old.patches)do check(bytesEqual(v.address,v.patch),'外观入口已被其他脚本改变')end
  addCosmeticNameHook(old);return old
 end
 local specs={{rva=0x5DEAD0,bytes={0x48,0x89,0x74,0x24,0x18,0x48,0x89,0x7C,0x24,0x20},kind='portrait'},
 {rva=0x5D8138,bytes={0x8B,0x86,0xF0,0,0,0},kind='id'},
 {rva=0x5D8179,bytes={0x8B,0x96,0xF4,0,0,0},kind='level'}}
 for _,v in ipairs(specs)do check(bytesEqual(base+v.rva,v.bytes),'外观函数版本不匹配，停止安装')end
 local mem=check(allocateMemory(4096,base+0x5DEAD0),'外观内存分配失败');local d=mem+0xF00
 check(math.abs(mem-(base+0x5DEAD0))&lt;0x7FFF0000,'外观跳转距离超限');check(writeInteger(d,0),'初始化失败')
 local b={pid=pid,base=base,data=d,mem=mem,patches={}}
 local ok,err=pcall(function()
  for n,v in ipairs(specs)do
   local address=base+v.rva;local codeAddress=mem+(n-1)*0x200;local body
   if v.kind=='portrait' then
    body=string.format('pushfq\npush rax\nmov rax,%X\ncmp dword ptr [rax],1\njne skip\ncmp dword ptr [rcx+58],0\njne skip\ncmp byte ptr [rcx+10],0\njne skip\nmov r8d,[rax+4]\nmov r9d,[rax+8]\nskip:\npop rax\npopfq\n',d)
   else
    body=string.format('pushfq\npush r11\nmov r11,%X\ncmp dword ptr [r11],1\njne original\ncmp dword ptr [rsi+58],0\njne original\ncmp byte ptr [rsi+10],0\njne original\n%s\njmp skip\noriginal:\n%s\nskip:\npop r11\npopfq\n',d,v.kind=='id' and 'mov eax,[r11+4]' or 'mov edx,[r11+8]',v.kind=='id' and 'mov eax,[rsi+F0]' or 'mov edx,[rsi+F4]')
   end
   local hex={};for _,byte in ipairs(v.bytes)do hex[#hex+1]=string.format('%02X',byte)end;local original=table.concat(hex,' ')
   assemble(string.format('label(skip)\n%s%X:\n%s%sjmp %X',v.kind~='portrait' and 'label(original)\n' or '',codeAddress,body,v.kind=='portrait' and ('db '..original..'\n') or '',address+#v.bytes))
   assemble(string.format('assert(%X,%s)\n%X:\njmp %X\n%s',address,original,address,codeAddress,string.rep('nop\n',#v.bytes-5)))
   b.patches[#b.patches+1]={address=address,original=v.bytes,patch=readBytes(address,#v.bytes,true)}
  end
 end)
 if not ok then
  writeInteger(d,0)
  for _,v in ipairs(b.patches)do if bytesEqual(v.address,v.patch)then local a={};for _,byte in ipairs(v.original)do a[#a+1]=string.format('%02X',byte)end;autoAssemble(string.format('%X:\ndb %s',v.address,table.concat(a,' ')))end end
  error(err)
 end
 LongYiCosmeticV1=b;addCosmeticNameHook(b);return b
end
function E.cosmeticWatch()
 if E.cosmeticTimer then return end
 local t=createTimer(nil);t.Interval=750;E.cosmeticTimer=t
 t.OnTimer=function()
  if E.busy then return end
  local h=LongYiCosmeticV1
  if not h or h.pid~=getOpenedProcessID()then t.destroy();E.cosmeticTimer=nil;return end
  local enabled=readInteger(h.data)==1
  if not enabled and not E.cosmeticRestorePending then t.destroy();E.cosmeticTimer=nil;return end
  local ok,b=pcall(cosmeticBattle)
  if not ok then return end
  if not b then if not enabled then E.cosmeticRestorePending=false;t.destroy();E.cosmeticTimer=nil end;return end
  if readBytes(b.battle+0x128,1)==1 then return end
  local id,level
  if enabled then id=readInteger(h.data+4);level=readInteger(h.data+8) else id=int(b.context.hero+0xF0);level=int(b.context.hero+0xF4)end
  if id&gt;=0x80000000 then id=id-0x100000000 end
  local expected='skin'..id..(readBytes(b.context.hero+0x80,1)==1 and 'f' or '')..'_'..level
  local stamp=expected..':'..b.unit..':'..b.active
  if b.name==expected and E.cosmeticHudStamp==stamp then E.cosmeticRestorePending=false;return end
  local submitted,err=pcall(E.refreshBattleOutfit,b,function(success,msg)
   E.cosmeticLastStatus=success and ('战斗模型与属性立绘：'..msg) or msg
   if success then E.cosmeticHudStamp=stamp end
   if not success or msg~=expected then t.destroy();E.cosmeticTimer=nil;E.cosmeticLastStatus='战斗自动刷新已停止：'..msg end
   if not enabled then E.cosmeticRestorePending=false end
  end)
  if not submitted then E.cosmeticLastStatus=tostring(err);t.destroy();E.cosmeticTimer=nil end
 end
end
function E.applyCosmetic(id,level)
 check(not E.busy,'已有请求执行中，请等待');local s=E.outfitSnapshot()
 check(s.byID[id] and type(level)=='number' and level%1==0 and level&gt;=0 and level&lt;=5,'服装或款式无效')
 local h=installCosmetic();check(writeInteger(h.data,0),'暂停外观替换失败')
 check(writeInteger(h.data+4,id) and writeInteger(h.data+8,level),'外观选择写入失败');check(writeInteger(h.data,1),'启用外观失败')
 E.cosmeticRestorePending=false;E.cosmeticHudStamp=nil;E.cosmeticWatch()
 return s
end
function E.stopCosmetic()
 check(not E.busy,'已有请求执行中，请等待');local h=LongYiCosmeticV1
 if h and h.pid==getOpenedProcessID()then check(writeInteger(h.data,0),'关闭外观替换失败');E.cosmeticRestorePending=true;E.cosmeticHudStamp=nil;E.cosmeticWatch()end
 E.outfitPreview=nil
end

-- Cosmetic portrait preview: forced renderer parameters, never SetSkin.
function E.outfitSnapshot()
 local c=context();local base=getAddressSafe('GameAssembly.dll')
 local manager=q(q(q(base+0x1E528F8)+0xB8)+0x20);local list=q(manager+0x1B8);local count=int(list+0x18)
 check(count&gt;0 and count&lt;1000,'服装目录异常');local a=q(list+0x10);local rows,byID={},{}
 for n=0,count-1 do local p=q(a+0x20+n*8);local id=int(p+0x10);if id&gt;=0x80000000 then id=id-0x100000000 end
  local dlc=int(p+0x28);if dlc&gt;=0x80000000 then dlc=dlc-0x100000000 end
  local t={id=id,name=str(q(p+0x18)),dlc=dlc};rows[#rows+1]=t;byID[id]=t
 end
 table.sort(rows,function(a,b)return a.id&lt;b.id end)
 local current=int(c.hero+0xF0);if current&gt;=0x80000000 then current=current-0x100000000 end
 check(same(c,context()),'读取期间存档变化，请刷新')
 return {context=c,rows=rows,byID=byID,current=current,level=int(c.hero+0xF4)}
end
function E.previewOutfit(previous,id,level,restore,onDone)
 check(not E.busy,'已有请求执行中，请等待')
 local h=LongYiCosmeticV1
 check(not h or h.pid~=getOpenedProcessID() or readInteger(h.data)~=1 or (not restore and readInteger(h.data+8)==level and (readInteger(h.data+4)==id or readInteger(h.data+4)==id+0x100000000)),'持续替换已启用，请用应用持续外观切换，或先关闭替换')
 local s=E.outfitSnapshot();local c=s.context
 check(previous and same(previous.context,c),'存档或背包变化，请刷新列表')
 if restore then id=-99;level=-1 else
  check(s.byID[id],'请从列表选择服装')
  check(type(level)=='number' and level%1==0 and level&gt;=0 and level&lt;=5,'款式必须为 0～5')
 end
 local base=getAddressSafe('GameAssembly.dll');local detailStatic=q(q(base+0x1E55AE8)+0xB8);local detail=q(detailStatic)
 check(q(detail+0x60)==c.hero,'请先在游戏中打开主角的人物详情页，不能停在 NPC 页面')
 -- RIP-relative slot from HeroDetailController.RefreshHeroSkeleton.
 local faceSlot=base+0xB191E9+0x1369BDF
 local face=readQword(faceSlot)
 check(face and face~=0,'未初始化立绘路径，请先打开主角详情页')
 local faceOK,faceName=pcall(str,face)
 check(faceOK and faceName=='Face','无法定位立绘路径 Face，请确认已载入最新版 CT 且游戏版本匹配')
 local panel=q(detail+0x20);local _,items=E.snapshot();check(#items&gt;0,'背包至少需要一件物品以校验桥接版本')
 local b=bridge(c,items[1]);local d=b.data;check(int(d)~=1 and int(d)~=2,'原生请求尚未完成')
 local setter=method(q(c.hero),'SetSkeletonGraphic',3,0x5DEAD0,base)
 local getter=method(q(c.hero),'GetSkeletonGraphic',1,0x5CC040,base)
 local original={};for n=0,27 do original[n+1]=readBytes(c.hero+0xEC+n,1)end
 for off,v in pairs({[8]=q(q(q(base+0x1E52870)+0xB8)),[0x10]=c.world,[0x18]=c.hero,[0x20]=c.inv,[0x28]=c.list,[0x30]=c.array,[0x50]=setter,[0x68]=0,[0xC8]=d+0x200,[0x200]=0,[0x208]=d+0x240,[0x210]=d+0x248,[0x350]=detail,[0x358]=detailStatic,[0x360]=panel,[0x368]=face,[0x370]=base+0xF2CDA0,[0x378]=base+0xB057E0,[0x380]=getter,[0x388]=0})do check(writeQword(d+off,v),'预览参数写入失败')end
 for off,v in pairs({[0x38]=c.version,[0x3C]=c.count,[0x98]=5,[0x240]=id,[0x248]=level})do check(writeInteger(d+off,v),'预览参数写入失败')end
 local timer=createTimer(nil);timer.Enabled=false;timer.Interval=100;E.busy=true;E.copyTimer=timer
 timer.OnTimer=function()
  local state=getOpenedProcessID()==c.pid and readInteger(d) or -1
  if state==1 or state==2 then return end
  timer.destroy();E.copyTimer=nil;E.busy=false
  local ok,msg=pcall(function()
   check(state==3,({[4]='页面或存档已变化，未执行。请打开主角详情页再试。',[5]='预览方法异常，请重新打开人物详情页恢复。'})[state] or '预览未完成，请检查游戏进程')
   local now=context();check(now.world==c.world and now.hero==c.hero,'已经切换存档，请刷新')
   for n,v in ipairs(original)do check(readBytes(c.hero+0xEC+n-1,1)==v,'实际服装数据发生变化，请检查游戏状态')end
   local graphic=q(d+0x388);check(cname(graphic)=='SkeletonGraphic','立绘组件不匹配')
   local skeleton=q(graphic+0x1A0);local kl=q(skeleton);local fp=q(kl+0x80);local rendered
   for n=0,200 do local f=fp+n*32;if readQword(f+16)~=kl then break end
    if readString(q(f),100)=='skin' then local skin=q(skeleton+int(f+24));rendered=str(q(skin+0x10));break end
   end
   local expected='skin'..(restore and s.current or id)..'_'..(restore and s.level or level)
   check(rendered==expected,'立绘未切到目标款式，实际：'..tostring(rendered)..'。可点恢复原样。')
   E.outfitPreview=not restore and {id=id,level=level,hero=c.hero} or nil
   return restore and '已恢复当前实际服装外观。' or ('正在预览「'..s.byID[id].name..'」款式 '..level..'。实际服装及属性未切换。')
  end)
  onDone(ok,tostring(msg))
 end
 if not writeInteger(d,1)then timer.destroy();E.copyTimer=nil;E.busy=false;error('预览请求提交失败')end
 timer.Enabled=true
end
function E.showOutfits()
 if E.outfitForm then E.outfitForm.show();E.outfitForm.bringToFront();if not E.busy then E.refreshOutfits()end;return end
 local f=createForm(false);E.outfitForm=f;f.Caption='服装试衣间 · 立绘 / 对话 / 战斗';f.Width=570;f.Height=740;f.Position='poScreenCenter';f.OnClose=function()return caHide or 1 end
 local function lab(s,x,y,w)local a=createLabel(f);a.Caption=s;a.Left=x;a.Top=y;if w then a.Width=w;a.WordWrap=true end;return a end
 local function btn(s,x,y,w,fn)local a=createButton(f);a.Caption=s;a.Left=x;a.Top=y;a.Width=w;a.OnClick=function()local ok,err=pcall(fn);if not ok then showMessage(tostring(err))end end;return a end
 lab('搜索名称 / ID',12,16);local search=createEdit(f);search.Left=115;search.Top=10;search.Width=285;search.Text=''
 local current=lab('',12,45,535)
 local view=createListView(f);view.Left=12;view.Top=75;view.Width=535;view.Height=365;view.ViewStyle='vsReport';view.ReadOnly=true;view.RowSelect=true;view.HideSelection=false
 for _,v in ipairs({{'ID',65},{'服装',240},{'资源分类',190}})do local col=view.Columns.add();col.Caption=v[1];col.Width=v[2]end
 lab('款式',12,459);local variant=createComboBox(f);variant.Left=58;variant.Top=453;variant.Width=130;variant.Style='csDropDownList'
 for n=0,5 do variant.Items.add('款式 '..n)end;variant.ItemIndex=5
 local status=lab('预览用于试穿；应用持续外观用于立绘、对话与战斗。',12,620,535);status.Height=40
 lab('持续替换在本次游戏进程有效；重启后重新应用。服装属性不变，特殊角色专用骨骼尚未适配。',12,667,535)
 local snapshot,visible,selected;local quiet=false
 local function draw()
  if not snapshot then return end;quiet=true;view.Items.clear();view.ItemIndex=-1;selected=nil;visible={}
  for _,t in ipairs(snapshot.rows)do if (t.name..' '..t.id):find(search.Text or '',1,true)then
   visible[#visible+1]=t;local row=view.Items.add();row.Caption=tostring(t.id);row.SubItems.add(t.name);row.SubItems.add(t.dlc&gt;=0 and 'DLC 资源' or '内置服装')
  end end;quiet=false
 end
 local function refresh()
  check(not E.busy,'预览请求执行中，请等待');snapshot=E.outfitSnapshot();draw()
  local t=snapshot.byID[snapshot.current];current.Caption='实际服装：'..(t and t.name or tostring(snapshot.current))..' / 款式 '..snapshot.level..'　目录 '..#snapshot.rows..' 套'
 end
 E.refreshOutfits=refresh;search.OnChange=draw
 view.OnClick=function()if quiet then return end;selected=visible[view.ItemIndex+1];if selected then status.Caption='已选「'..selected.name..'」，选择款式后点击预览。'end end
 view.OnSelectItem=function(_,_,yes)if yes then view.OnClick()end end
 local function submit(restore)
  check(restore or selected,'请先选择服装')
  E.previewOutfit(snapshot,selected and selected.id,variant.ItemIndex,restore,function(ok,msg)status.Caption=msg;if not ok then showMessage(msg)end end)
  status.Caption='已提交；请回到游戏查看立绘，等待完成后再试下一套。'
 end
 btn('刷新',415,8,130,refresh)
 btn('预览选中服装',205,451,170,function()submit(false)end)
 btn('恢复原样',390,451,155,function()E.stopCosmetic();submit(true)end)
 btn('应用持续外观',12,540,255,function()
  check(selected,'请选择服装');snapshot=E.applyCosmetic(selected.id,variant.ItemIndex)
  local ok,err=pcall(function()E.previewOutfit(snapshot,selected.id,variant.ItemIndex,false,function(success,msg)status.Caption=success and ('持续替换已开启。'..msg) or msg end)end)
  status.Caption=ok and '持续替换已开启，正在刷新立绘；战斗模型将自动同步。' or '持续替换已开启；下一次立绘/对话刷新时生效，战斗模型自动同步。'
 end)
 btn('关闭持续替换',285,540,260,function()
  E.stopCosmetic();snapshot=E.outfitSnapshot()
  local ok=pcall(function()E.previewOutfit(snapshot,nil,nil,true,function(success,msg)status.Caption=msg end)end)
  status.Caption=ok and '已关闭持续替换，正在恢复立绘和战斗外观。' or '已关闭持续替换；重新打开立绘或对话恢复显示，战斗自动恢复。'
 end)
 local liveStatus=lab('持续替换：未启用',12,590,535)
 local feedback=createTimer(f);feedback.Interval=1000;feedback.OnTimer=function()
  local h=LongYiCosmeticV1;local active=h and h.pid==getOpenedProcessID() and readInteger(h.data)==1
  liveStatus.Caption=(active and '持续替换：已启用　' or '持续替换：已关闭　')..(E.cosmeticLastStatus or '')
 end
 view.OnDblClick=function()local ok,err=pcall(function()view.OnClick();submit(false)end);if not ok then showMessage(tostring(err))end end
 lab('双击服装也可预览。窗口可以拖到游戏立绘旁边，边选边看。',12,505,535)
 f.show();local ok,err=pcall(refresh);if not ok then status.Caption=tostring(err)end
end

-- Native force bonus catalog; no global configuration edits or polling writes.
function E.sectBonusSnapshot()
 local c=context();local fid=int(c.hero+0x84);check(fid&gt;=0,'主角尚未加入门派')
 local ls=q(c.world+0x48);local a=q(ls+16);local count=int(ls+24);check(count&gt;=0 and count&lt;10000,'门派列表异常')
 local force
 for j=0,count-1 do local p=q(a+32+j*8);if int(p+16)==fid then force=p;break end end
 check(force and cname(force)=='ForceData','未找到当前门派')
 local bonus=q(force+0x148);check(cname(bonus)=='ForceSpeAddData','门派加成类型不符')
 local dict=q(bonus+16);local ec=int(dict+32);check(ec&gt;=0 and ec&lt;1000,'门派加成数量异常')
 local entries=readQword(dict+24);local values={}
 if ec&gt;0 then check(entries and entries~=0,'加成字典不可读')end
 for j=0,ec-1 do local e=entries+32+j*16;local h=int(e);if h&gt;=0 and h&lt;0x80000000 then values[int(e+8)]=flt(e+12)end end
 local base=getAddressSafe('GameAssembly.dll');local manager=q(q(q(base+0x1E528F8)+0xB8)+32)
 local catalog=q(manager+0x98);local ca=q(catalog+16);local n=int(catalog+24);check(n==65,'门派加成目录已变化，请检查游戏版本')
 local rows,byID={},{}
 for id=0,n-1 do
  local p=q(ca+32+id*8);local group
  if id&lt;=2 or id==59 then group='容量 / 上限'
  elseif id&gt;=35 and id&lt;=58 then group='全员属性'
  elseif id&gt;=60 then group='领地'
  elseif id==3 or id==6 or id==7 or (id&gt;=16 and id&lt;=34)then group='经验 / 功绩'
  elseif id==14 or id==15 then group='资源产量'
  else group='速度 / 恢复'end
  local row={id=id,name=str(readQword(p+16)),description=str(readQword(p+24)),percent=readBytes(p+32,1)==1,value=values[id] or 0,group=group}
  rows[#rows+1]=row;byID[id]=row
 end
 check(same(c,context()) and int(c.hero+0x84)==fid,'读档或门派发生变化，请刷新')
 return {context=c,id=fid,force=force,bonus=bonus,rows=rows,byID=byID,name=str(readQword(force+0x198))~='' and str(readQword(force+0x198)) or str(readQword(force+24))}
end
function E.sectBonusCompatible(a,b)
 return a and b and same(a.context,b.context) and a.id==b.id and a.force==b.force
end
function E.setSectBonuses(previous,changes,undoing)
 check(not E.busy and not E.skillTraining,'其他操作尚未完成')
 local fresh=E.sectBonusSnapshot();check(E.sectBonusCompatible(previous,fresh),'已读档或切换门派，请刷新')
 local work={}
 if E.sectSpeedLock then for id,v in pairs(changes)do check(not E.sectSpeedTargets[id] or math.abs(v-E.sectSpeedTargets[id])&lt;0.0001,'该项目正在锁定，请先停止锁定再修改或撤销')end end
 for id,value in pairs(changes)do
  check(fresh.byID[id] and type(value)=='number' and value==value and math.abs(value)&lt;=1000000,'数值无效或过大')
  work[#work+1]={id=id,value=value,old=fresh.byID[id].value}
 end
 check(#work&gt;0,'没有需要写入的项目');table.sort(work,function(a,b)return a.id&lt;b.id end)
 local base=getAddressSafe('GameAssembly.dll');E.recoverCurrentBridge(base,base+0x18B9460,fresh.context.pid)
 local history={snapshot=fresh,changes={},after={}}
 if not undoing then E.sectBonusUndo=history end
 E.busy=true
 local ok,err=pcall(function()
  E.callSectNative(function(invoke,number,_,float)
   for _,r in ipairs(work)do
    local now=E.sectBonusSnapshot();check(E.sectBonusCompatible(fresh,now),'读档或门派变化，停止写入')
    check(math.abs(now.byID[r.id].value-r.old)&lt;0.0001,'加成已被游戏重算，请刷新后重试')
    history.changes[r.id]=r.old;history.after[r.id]=r.value
    invoke(now.bonus,'Set',{number(r.id),float(r.value)},0x1854D70)
    local after=E.sectBonusSnapshot();check(E.sectBonusCompatible(fresh,after),'写入期间已切换存档')
    check(math.abs(after.byID[r.id].value-r.value)&lt;=math.max(0.0001,math.abs(r.value)*0.000001),'写入未生效或已被重算')
   end
  end)
 end)
 E.busy=nil
 if not ok then error('门派加成操作未全部完成：'..tostring(err)..'。请刷新核对；已尝试的项目保留撤销记录。')end
 if undoing then E.sectBonusUndo=nil end
 return #work
end
function E.stopSectSpeedLock(reason)
 local lock=E.sectSpeedLock;E.sectSpeedLock=nil
 if lock and lock.timer then lock.timer.Enabled=false;lock.timer.OnTimer=nil;lock.timer.destroy()end
 if E.sectLockNotice then E.sectLockNotice(reason or '锁定已停止；当前数值保留，可用撤销恢复启用前的值。')end
end
E.sectSpeedTargets={[4]=99.99,[5]=9.99,[8]=9.99,[9]=9.99,[10]=9.99,[11]=9.99,[12]=99.99,[13]=99.99}
function E.sectSpeedLockTick()
 local lock=E.sectSpeedLock;if not lock or E.busy then return end
 local ok,err=pcall(function()
  local s=E.sectBonusSnapshot();check(E.sectBonusCompatible(lock.snapshot,s),'已读档或切换门派')
  local dict=q(s.bonus+16);local entries=q(dict+24);local version=int(dict+36);local count=int(dict+32);local slots={}
  check(count&gt;=0 and count&lt;1000,'加成字典异常')
  for j=0,count-1 do local e=entries+32+j*16;local h=int(e)
   if h&gt;=0 and h&lt;0x80000000 then local id=int(e+8);if E.sectSpeedTargets[id]then slots[id]=e end end
  end
  for id in pairs(E.sectSpeedTargets)do check(slots[id],'加成条目被移除，请重新开启锁定')end
  for id,value in pairs(E.sectSpeedTargets)do
   check(same(s.context,context()) and int(s.context.hero+0x84)==s.id,'读档或门派变化')
   check(q(s.force+0x148)==s.bonus and q(s.bonus+16)==dict and q(dict+24)==entries and int(dict+36)==version,'加成结构正在重算')
   local e=slots[id];check(int(e)&gt;=0 and int(e)&lt;0x80000000 and int(e+8)==id,'加成条目已变化')
   if math.abs(flt(e+12)-value)&gt;0.0001 then check(writeFloat(e+12,value),'锁定写入失败')end
  end
 end)
 if not ok then E.stopSectSpeedLock('锁定已自动停止：'..tostring(err)..'。请刷新后重新开启。')end
end
function E.startSectSpeedLock(previous)
 check(not E.sectSpeedLock,'锁定已开启');check(not E.busy,'其他操作进行中')
 E.setSectBonuses(previous,E.sectSpeedTargets)
 local fresh=E.sectBonusSnapshot();check(E.sectBonusCompatible(previous,fresh),'存档已变化，未开启锁定')
 local timer=createTimer(nil,false);local lock={snapshot=fresh,timer=timer};E.sectSpeedLock=lock
 timer.Interval=750;timer.OnTimer=E.sectSpeedLockTick;timer.Enabled=true
 return '锁定中：科研、建造、本地建造 +9999%；旅行、疗伤与恢复 +999%。关闭面板或切换存档会停止。'
end

function E.showSectBonuses()
 if E.sectBonusForm then E.sectBonusForm.show();E.sectBonusForm.bringToFront();return end
 local f=createForm(false);E.sectBonusForm=f;f.Caption='门派加成管理 · 当前门派';f.Width=940;f.Height=710;f.Position='poScreenCenter';f.OnClose=function()E.stopSectSpeedLock();return caHide or 1 end
 local function lab(text,x,y)local p=createLabel(f);p.Caption=text;p.Left=x;p.Top=y;return p end
 local status=lab('正在读取门派加成……',16,604);status.Width=890;status.Height=68;status.WordWrap=true
 local function btn(text,x,y,w,fn)local p=createButton(f);p.Caption=text;p.Left=x;p.Top=y;p.Width=w;p.OnClick=function()local ok,err=pcall(fn);if not ok then status.Caption=tostring(err);showMessage(tostring(err))end end;return p end
 lab('搜索名称 / ID',16,17);local search=createEdit(f);search.Left=120;search.Top=12;search.Width=330
 local filter=createComboBox(f);filter.Left=465;filter.Top=12;filter.Width=210;filter.Style='csDropDownList'
 for _,v in ipairs({'全部','速度 / 恢复','经验 / 功绩','资源产量','全员属性','容量 / 上限','领地'})do filter.Items.add(v)end;filter.ItemIndex=0
 local view=createListView(f);view.Left=16;view.Top=52;view.Width=890;view.Height=370;view.ViewStyle='vsReport';view.ReadOnly=true;view.RowSelect=true;view.HideSelection=false
 for _,v in ipairs({{'ID',50},{'名称',230},{'分类',170},{'当前加成',150},{'本次方案',150}})do local col=view.Columns.add();col.Caption=v[1];col.Width=v[2]end
 local detail=lab('选择一项后输入新值。百分比直接填 100，表示加成 +100%。',16,438);detail.Width=890;detail.Height=48;detail.WordWrap=true
 lab('新加成',16,503);local value=createEdit(f);value.Left=90;value.Top=496;value.Width=150;local unit=lab('',250,503)
 local snapshot,visible,selected,planScope;local plan={};local quiet=false
 local function fmt(row,v)return string.format('%.4g',row.percent and v*100 or v)..(row.percent and '%' or '')end
 local function draw()
  quiet=true;view.Items.beginUpdate();view.Items.clear();visible={};selected=nil
  if snapshot then for _,r in ipairs(snapshot.rows)do
   if (filter.ItemIndex==0 or r.group==filter.Text) and (r.name..' '..r.id):find(search.Text or '',1,true)then
    visible[#visible+1]=r;local item=view.Items.add();item.Caption=tostring(r.id);item.SubItems.add(r.name);item.SubItems.add(r.group);item.SubItems.add(fmt(r,r.value));item.SubItems.add(plan[r.id]~=nil and fmt(r,plan[r.id]) or '')
   end
  end end
  view.Items.endUpdate();quiet=false
 end
 local function refresh()
  check(not E.busy,'操作进行中');local fresh=E.sectBonusSnapshot()
  if not E.sectBonusCompatible(planScope,fresh)then plan={};planScope=fresh;E.sectBonusUndo=nil end
  snapshot=fresh;f.Caption='门派加成管理 · '..fresh.name;draw();status.Caption='已读取 65 项。当前汇总加成可能在科技升级、过日或读档后重算；本次方案可重新应用。可用右下角按钮持续锁定速度。'
 end
 search.OnChange=draw;filter.OnChange=draw
 view.OnSelectItem=function(_,_,yes)if yes and not quiet then
  selected=visible[view.ItemIndex+1];if selected then value.Text=string.format('%.6g',selected.percent and selected.value*100 or selected.value);unit.Caption=selected.percent and '% 加成' or '固定加成';detail.Caption=selected.name..'：当前 '..fmt(selected,selected.value)..'。'..(selected.percent and '填 100 = +100%，不是最终倍率；本地项仍遵循游戏作用范围。' or '填写加成量，不是最终总属性。')end
 end end
 btn('刷新',705,10,200,refresh)
 btn('写入选中加成',355,494,180,function()
  check(selected,'请先选中一项');local r=selected;local v=tonumber(((value.Text or ''):gsub('%%','')));check(v,'请输入有效数字');if r.percent then v=v/100 end
  E.setSectBonuses(snapshot,{[r.id]=v});plan[r.id]=v;refresh();status.Caption='已写入「'..r.name..'」。若游戏界面未更新，请重新打开相应页面；重算覆盖后可重新应用方案。'
 end)
 btn('撤销上次写入',555,494,170,function()
  local h=check(E.sectBonusUndo,'没有可撤销的修改');local now=E.sectBonusSnapshot();check(E.sectBonusCompatible(h.snapshot,now),'已切换存档，不能撤销旧数据')
  for id,v in pairs(h.after)do check(math.abs(now.byID[id].value-v)&lt;=math.max(0.0001,math.abs(v)*0.000001),'数值已被重算或另行修改，停止撤销')end
  E.setSectBonuses(now,h.changes,true);for id in pairs(h.changes)do plan[id]=nil end;refresh();status.Caption='已恢复上次写入前的加成。'
 end)
 btn('重新应用本次方案',16,550,240,function()local n=E.setSectBonuses(planScope,plan);refresh();status.Caption='已重新应用 '..n..' 项加成。'end)
 btn('清空方案（不改数值）',280,550,240,function()check(not E.busy,'操作进行中');plan={};draw();status.Caption='方案已清空；当前游戏数值保持不变。'end)
 local lockButton=createButton(f);lockButton.Left=550;lockButton.Top=550;lockButton.Width=355;lockButton.Caption='锁定速度：科研建造9999% / 其余999%'
 E.sectLockNotice=function(msg)lockButton.Caption=E.sectSpeedLock and '停止速度锁定' or '锁定速度：科研建造9999% / 其余999%';status.Caption=msg end
 lockButton.OnClick=function()
  local ok,msg=pcall(function()
   if E.sectSpeedLock then E.stopSectSpeedLock();return end
   local text=E.startSectSpeedLock(check(snapshot,'请先刷新'))
   for id,v in pairs(E.sectSpeedTargets)do plan[id]=v end
   refresh();E.sectLockNotice(text)
  end)
  if not ok then E.sectLockNotice(tostring(msg));showMessage(tostring(msg))end
 end
 f.show();local ok,err=pcall(refresh);if not ok then status.Caption=tostring(err)end
end

if LONGYI_INVENTORY_TEST then return E end
if LongYiInventory and LongYiInventory.uiVersion==E.uiVersion and LongYiInventory.open then
 LongYiInventory.open();return
end
if LongYiInventory and LongYiInventory.busy then error('旧版请求尚未完成，请回到游戏等待后再打开新版编辑器') end
if LongYiInventory and LongYiInventory.stopAutoSkill then LongYiInventory.stopAutoSkill();LongYiInventory.autoSkillNotice=nil end
if LongYiInventory and LongYiInventory.stopSectSpeedLock then LongYiInventory.stopSectSpeedLock();LongYiInventory.sectLockNotice=nil end
if LongYiInventory and LongYiInventory.form then
 if LongYiInventory.cosmeticTimer then LongYiInventory.cosmeticTimer.destroy();LongYiInventory.cosmeticTimer=nil end
 if LongYiInventory.outfitForm then pcall(function()LongYiInventory.outfitForm.destroy()end) end
 if LongYiInventory.recoveryForm then pcall(function()LongYiInventory.recoveryForm.destroy()end) end
 if LongYiInventory.discipleAllForms then for _,window in ipairs(LongYiInventory.discipleAllForms)do pcall(function()window.destroy()end)end end
 if LongYiInventory.discipleForm then pcall(function()LongYiInventory.discipleForm.destroy()end) end
 if LongYiInventory.sectBonusForm then pcall(function()LongYiInventory.sectBonusForm.destroy()end) end
 if LongYiInventory.skillForm then pcall(function()LongYiInventory.skillForm.destroy()end) end
 if LongYiInventory.tagForm then pcall(function()LongYiInventory.tagForm.destroy()end) end
 if LongYiInventory.catalogForm then pcall(function()LongYiInventory.catalogForm.destroy()end) end
 if LongYiInventory.rangeForm then pcall(function()LongYiInventory.rangeForm.destroy()end) end
