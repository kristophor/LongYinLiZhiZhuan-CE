   if (kfilter.ItemIndex==0 or t.kind==kfilter.ItemIndex-1) and (rfilter.ItemIndex==0 or t.rarity==rfilter.ItemIndex-1) and (term=='' or (t.id..' '..t.name..' '..t.description):lower():find(term,1,true))then
