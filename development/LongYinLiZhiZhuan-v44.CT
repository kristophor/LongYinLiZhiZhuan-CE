form.Caption='龙胤立志传 · 背包物品管理';form.Width=1220;form.Height=930;form.Position='poScreenCenter'
local function label(s,x,y) local a=createLabel(form);a.Caption=s;a.Left=x;a.Top=y;return a end
local function edit(s,x,y,w) local a=createEdit(form);a.Text=s;a.Left=x;a.Top=y;a.Width=w;return a end
local function button(s,x,y,w,fn) local a=createButton(form);a.Caption=s;a.Left=x;a.Top=y;a.Width=w;a.OnClick=function()local ok,err=pcall(fn);if not ok then showMessage(tostring(err)) end end;return a end
label('搜索名称 / ID / 描述：',12,16);local search=edit('',175,12,420)
