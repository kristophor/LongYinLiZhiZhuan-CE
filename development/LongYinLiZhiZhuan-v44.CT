local inputs={}
for n,s in ipairs(specs) do local x=12+(n-1)*195;label(s.label..'（只读）',x,655);inputs[s.key]=edit('',x,677,175);inputs[s.key].ReadOnly=true;inputs[s.key].Enabled=false end
local function clearSelection()
 selected=nil;selectedLabel.Caption='选择物品查看说明。';details.Lines.Text=''
 for _,s in ipairs(specs) do inputs[s.key].Text='';inputs[s.key].Enabled=false end
end
local function chosen(key) local f=filters[key];return f.values[f.control.ItemIndex] end
local function populate(key,domain)
 local f=filters[key];local old=chosen(key);local values,labels,seen={},{},{}
 for _,r in ipairs(domain or {}) do
  local value=key=='subtype' and r.subtypeKey or r[key]
  if value~=nil and not seen[value] then
   seen[value]=true;values[#values+1]=value
   labels[value]=key=='type' and (r.typeName..' ('..value..')') or key=='subtype' and (r.typeName..' / '..r.subtypeName..' ('..r.subtype..')') or key=='quality' and (r.qualityName..' ('..value..')') or tostring(value)
  end
 end
 table.sort(values,function(a,b)return a&lt;b end);f.values=values;f.control.Items.clear();f.control.Items.add('全部');local pick=0
 for n,v in ipairs(values) do f.control.Items.add(labels[v]);if v==old then pick=n end end
 f.control.ItemIndex=pick
end
local function choose()
 if suppress then return end
 local r=visible and visible[view.ItemIndex+1]
 if not r then clearSelection();return end
 selected=E.validate(ctx,r)
 selectedLabel.Caption=string.format('选中 #%d　%s　|　%s　等级 %d　品质 %d',selected.index+1,selected.displayName,selected.typeName,selected.level,selected.quality)..'　'..selected.equipStatus
 details.Lines.Text=E.describe(selected)
 for _,s in ipairs(specs) do local available=not s.effect or selected.effect~=nil;inputs[s.key].Enabled=available;inputs[s.key].Text=available and tostring(selected[s.key]) or '' end
end
local function draw()
 if suppress then return end
 suppress=true;clearSelection();view.Items.clear();view.ItemIndex=-1
 visible=E.filterSort(rows or {},{search=search.Text,type=chosen('type'),subtype=chosen('subtype'),level=chosen('level'),quality=chosen('quality'),key=sort.key,asc=sort.asc})
 for n,col in ipairs(columns) do col.Caption=colSpecs[n][2]..(sort.key==colSpecs[n][1] and (sort.asc and ' ↑' or ' ↓') or '') end
 for _,r in ipairs(visible) do
  local row=view.Items.add();row.Caption=tostring(r.index+1)
  for n=2,#colSpecs do local k=colSpecs[n][1];local v=r[k]
   if k=='quality' then v=r.qualityName..' ('..r.quality..')' elseif type(v)=='number' then v=string.format('%g',v) end
   row.SubItems.add(v==nil and '—' or tostring(v))
  end
 end
 suppress=false;status.Caption=string.format('背包 %d 件，筛选显示 %d 件。点击列标题排序。',#(rows or {}),#visible)
end
local function refresh()
 check(not E.busy,'添加/复制请求执行中，请等完成后刷新')
 local c,r=E.snapshot();ctx,rows=c,r;suppress=true
 local ok,err=pcall(function()
  for _,key in ipairs({'type','subtype','level','quality'}) do populate(key,rows) end
 end)
 suppress=false;if not ok then error(err) end;draw()
end
local function guardedChoose() local ok,err=pcall(choose);if not ok then clearSelection();showMessage(tostring(err)) end end
view.OnClick=guardedChoose
view.OnSelectItem=function(_,_,yes) if yes then guardedChoose() end end
view.OnColumnClick=function(_,col)
 local s=colSpecs[col.Index+1];if not s then return end
 if sort.key==s[1] then sort.asc=not sort.asc else sort.key=s[1];sort.asc=true end
