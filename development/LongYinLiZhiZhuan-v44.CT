local filters={}
for n,s in ipairs({{'type','品类',12,210},{'subtype','子类',238,270},{'level','等级',524,190},{'quality','品质',730,190}}) do
 label(s[2],s[3],52);local cb=createComboBox(form);cb.Left=s[3];cb.Top=74;cb.Width=s[4];cb.Style='csDropDownList';cb.Items.add('全部');cb.ItemIndex=0
