 foodCategory.OnChange=nil;foodCategory.Items.clear();foodGroups={}
 if food then
  local ok,result=pcall(E.consumableGroups,key)
  if ok then foodGroups=result;for _,g in ipairs(result)do foodCategory.Items.add(g.caption)end;foodCategory.ItemIndex=0
   local good,err=pcall(selectBestFood);if not good then preview.Caption=tostring(err)end
  else preview.Caption=tostring(result)end
 end
 foodCategory.OnChange=function()local ok,err=pcall(selectBestFood);if not ok then preview.Caption=tostring(err)end end
end
createSub.OnChange=updateCreation
createType.OnChange=function()
 createSub.OnChange=nil;createSub.Items.clear()
 for _,item in ipairs(createGroups[createType.ItemIndex+1].items)do createSub.Items.add(item[2])end
 createSub.ItemIndex=0;createSub.Enabled=#createGroups[createType.ItemIndex+1].items&gt;1
 createSub.OnChange=updateCreation;updateCreation()
end
